{
  "schema": "heaven-plugin/manifest/v1",
  "name": "heaven-workflows",
  "version": "0.3.0",
  "entrypoint": "heaven_workflows.service:HeavenWorkflowPlugin",
  "capabilities": [
    "workflow.repo_snapshot",
    "workflow.verify_repo",
    "workflow.parallel_invoke",
    "workflow.release.plan",
    "workflow.release.verify_gates",
    "workflow.release.verify_artifacts",
    "workflow.release.authorize_publish",
    "workflow.release.reconcile_existing",
    "workflow.release.plan_cancellations",
    "workflow.change.status",
    "workflow.change.prepare",
    "workflow.change.commit",
    "workflow.change.rollback"
  ],
  "depends_on": {
    "heaven-control-plane": ">=0.4.0",
    "heaven-state-store": ">=0.1.0"
  },
  "security": {
    "raw_execution_from_parallel_scheduler": false,
    "max_parallel_tasks": 16,
    "max_workers": 8,
    "release_exact_commit_binding": true,
    "publish_requires_explicit_plan_confirmation": true,
    "artifact_digest_and_identity_verification": true,
    "superseded_run_cancellation_is_plan_only": true,
    "rollback_requires_explicit_registered_steps": true,
    "rollback_raw_execution_capabilities": false,
    "rollback_mutation_requires_confirmation": true,
    "rollback_credential_values_persisted": false
  }
}
