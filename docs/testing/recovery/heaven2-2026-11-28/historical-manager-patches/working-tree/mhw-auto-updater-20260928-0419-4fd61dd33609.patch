+    public string PayloadManifestSha256 { get; init; } = string.Empty;
+    public DateTimeOffset CreatedUtc { get; init; }
+    public DateTimeOffset PublishedUtc { get; init; }
+    public int MinimumUpdaterSchemaVersion { get; init; } = 1;
+
+    [JsonIgnore]
