+}
+
+public sealed class UpdateApplyJournal
+{
+    public int SchemaVersion { get; init; } = UpdateConstants.JournalSchemaVersion;
+    public string UpdateId { get; init; } = string.Empty;
+    public string InstallRoot { get; init; } = string.Empty;
+    public string StagingRoot { get; init; } = string.Empty;
+    public BuildIdentity Target { get; init; } = new("", "", 0, 0, null);
+    public UpdateApplyPhase Phase { get; set; }
+    public List<UpdateMutationRecord> Mutations { get; init; } = [];
+    public string? Failure { get; set; }
+    public DateTimeOffset UpdatedUtc { get; set; } = DateTimeOffset.UtcNow;
+}
+
+public static class UpdateJson
+{
+    public static JsonSerializerOptions CreateOptions()
+    {
+        using var __mhwTrace = MhwModManager.Core.MasterDebugLog.BeginMethod();
+        return new JsonSerializerOptions
+        {
+            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+            PropertyNameCaseInsensitive = false,
+            WriteIndented = true,
+            UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow,
+            Converters = { new JsonStringEnumConverter() }
+        };
+    }
+}
