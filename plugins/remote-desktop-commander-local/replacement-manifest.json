{
  "schema_version": 1,
  "replacement_id": "remote-desktop-commander-local",
  "status": "claimed",
  "upstream": {
    "name": "Remote Desktop Commander",
    "unavailable_conditions": [
      "missing",
      "removed",
      "usage_paused",
      "quota_exhausted",
      "provider_outage",
      "unsupported_operation"
    ]
  },
  "local_transport": "heaven-bridge",
  "providers": [
    "heaven-control-plane",
    "heaven-file-ops",
    "heaven-process-services",
    "heaven-desktop",
    "heaven-browser",
    "heaven-system-ops"
  ],
  "initial_workflows": [
    "host_presence",
    "storage_audit",
    "filesystem_inspection",
    "process_control",
    "desktop_control"
  ],
  "security": {
    "local_only": true,
    "no_public_listener": true,
    "no_secret_persistence": true,
    "no_quota_bypass": true,
    "requires_existing_user_authorization": true
  }
}
