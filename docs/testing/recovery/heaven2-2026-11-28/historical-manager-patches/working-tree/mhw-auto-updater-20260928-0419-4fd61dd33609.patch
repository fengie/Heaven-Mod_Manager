+        if (!payload.ProductId.Equals(UpdateConstants.ProductId, StringComparison.Ordinal))
+            throw new InvalidDataException("Payload product identity is invalid.");
+        if (!payload.Channel.Equals(UpdateConstants.Channel, StringComparison.Ordinal))
+            throw new InvalidDataException("Payload channel is invalid.");
+        if (payload.BuildNumber <= 0) throw new InvalidDataException("Payload build number must be positive.");
+        RequireSha(payload.SourceSha, "payload source SHA", 40);
+        if (!payload.Executable.Equals(UpdateConstants.ExecutableName, StringComparison.Ordinal))
