<Window x:Class="MhwModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MhwModManager.App"
        xmlns:vm="clr-namespace:MhwModManager.App.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1480" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Continue"
        Loaded="OnWindowLoaded"
        AllowDrop="True" PreviewDragOver="OnWindowPreviewDragOver" PreviewDrop="OnWindowPreviewDrop">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshAnalysisNowCommand}"/>
    </Window.InputBindings>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- App bar -->
        <Border Grid.Row="0" Background="#0A1018" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentDim}" BorderBrush="#24564F" BorderThickness="1">
                        <TextBlock Text="UM" Foreground="{StaticResource AccentBright}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Universal Mod Manager" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/>
                            <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="10" Background="#102A29" BorderBrush="#24564F" BorderThickness="1">
                                <TextBlock Text="{Binding CurrentProgramBuildText}" Foreground="{StaticResource AccentBright}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock MaxWidth="360" Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding HeaderSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderSummary}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D151F" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GAME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <Menu Background="Transparent" Padding="0">
                            <local:GameChoiceMenu ItemsSource="{Binding Games}" SwitchCommand="{Binding SwitchGameCommand}"
                                                  Header="{Binding ActiveGameDisplayName}" ToolTip="Switch game"
                                                  AutomationProperties.Name="Active game" AutomationProperties.AutomationId="ActiveGameSelector"
                                                  AutomationProperties.ItemStatus="{Binding ActiveGameDisplayName}">
                                <local:GameChoiceMenu.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentDim}" CornerRadius="6" Padding="8,4">
                                            <DockPanel Width="200">
                                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource AccentBright}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" AutomationProperties.AutomationId="ActiveGameDisplayName"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </local:GameChoiceMenu.HeaderTemplate>
                                <local:GameChoiceMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}"/>
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding GameRoot}"/>
                                    </Style>
                                </local:GameChoiceMenu.ItemContainerStyle>
                                <local:GameChoiceMenu.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel MaxWidth="520">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding GameRoot}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameRoot}" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </local:GameChoiceMenu.ItemTemplate>
                            </local:GameChoiceMenu>
                        </Menu>
                        <Button Content="Settings" Command="{Binding ConfigureGameCommand}" Style="{StaticResource QuietButton}" Margin="2,0,0,0" Padding="10,6"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/>
                    <Button Content="Launch Game" Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Back up your saves, check the setup, and launch the game with your enabled mods."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + pages -->
        <TabControl x:Name="MainTabs" Style="{StaticResource MainNavigationTabs}"
                    Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTab}"
                    SelectionChanged="OnMainTabSelectionChanged">
            <TabItem Header="Dashboard">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=GamePathText, StringFormat='Game folder: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=ModLibraryPathText, StringFormat='Mod library: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=GameDownloadsPathText, StringFormat='Downloads: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <Grid MaxWidth="1320" HorizontalAlignment="Stretch" Margin="32,30,36,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Your game, your mods, and the next action — without the clutter." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,22,0,14" Style="{StaticResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT SETUP" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SelectedGame.DisplayName}" FontSize="25" FontWeight="Bold"/>
                                    <TextBlock Margin="0,9,0,0" MaxWidth="650" Text="{Binding StatusText}" FontSize="16" TextWrapping="Wrap" LineHeight="23"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Button Content="Launch Game" Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}" Padding="20,11"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Margin="24,0,0,0" Padding="18" Background="#0B141E" BorderBrush="#27394C" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="APP &amp; GAME HEALTH" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AccentBright}" FontWeight="SemiBold" Text="{Binding ProgramUpdateStatus}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding LatestProgramBuildText}" TextWrapping="Wrap"/>
                                        <Border Margin="0,14,0,0" Height="1" Background="{StaticResource Border}"/>
                                        <TextBlock Margin="0,13,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding GamePathText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="4" Margin="-5,0,-5,14">
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EnabledCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                                    <TextBlock Text="Active mods" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="enabled in this setup" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FullyEffectiveCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Info}"/>
                                    <TextBlock Text="Working in game" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding ComposedCount,Mode=OneWay}"/><Run Text=" partly replaced"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BlockerCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                                    <TextBlock Text="Needs attention" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="choices before apply" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StagedCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBright}"/>
                                    <TextBlock Text="Pending changes" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="ready to apply" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,0,7,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Setup details" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Everything important about the current installation." Style="{StaticResource PageSubtitle}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeGood}">
                                            <TextBlock Text="CURRENT" Foreground="{StaticResource Good}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Border Margin="0,16,0,0" Padding="14" Background="#0B141E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                                        <TextBlock Text="{Binding UnmanagedAdoptionLabel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                    <StackPanel Margin="0,9,0,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding ModLibraryPathText}"/>
                                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding GameDownloadsPathText}"/>
                                        <Border Margin="0,14,0,0" Padding="12" Background="#0B141E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="AUTO-SORT MOD DOWNLOADS" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock Margin="0,6,0,0" Text="{Binding AutoSortStatusText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/>
                                                <ComboBox Margin="0,10,0,0" ItemsSource="{Binding AutoSortFolders}" SelectedItem="{Binding SelectedAutoSortFolder,Mode=TwoWay}"
                                                          ToolTip="Designated download folders monitored for game-specific mod packages."
                                                          AutomationProperties.Name="Monitored mod download folders"/>
                                                <WrapPanel Margin="0,9,0,0">
                                                    <Button Content="Add Folder" Command="{Binding AddAutoSortFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,7,5"
                                                            AutomationProperties.Name="Add automatic mod sorting folder"/>
                                                    <Button Content="Import Folder Once" Command="{Binding ImportModFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,7,5"
                                                            AutomationProperties.Name="Separate and import mods from a selected folder without monitoring it"/>
                                                    <Button Content="Remove Selected" Command="{Binding RemoveAutoSortFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,5"
                                                            AutomationProperties.Name="Stop monitoring selected mod folder without deleting data"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Margin="0,0,5,0" Style="{StaticResource ActionTile}" Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}"/>
                                        <Button Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource ActionTile}" Content="Launch Without Mods" Command="{Binding LaunchSafeModeCommand}"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Margin="0,0,5,0" Style="{StaticResource ActionTile}" Content="Restore Last Working Setup" Command="{Binding RestoreLastGoodCommand}"/>
                                        <Button Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource ActionTile}" Content="Review Shared Files" Command="{Binding ShowOverlapsCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Common things you may want to do next." Style="{StaticResource PageSubtitle}"/>
                                    <Button Margin="0,16,0,8" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Content="Install a Mod" Command="{Binding ImportArchiveCommand}"/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Import ZIP/RAR/7z Folder" Command="{Binding ImportModFolderCommand}" ToolTip="Import many downloaded mod archives for different registered games in one batch."/>
                                    <TextBlock Margin="3,0,3,10" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Text="Or drag ZIP/RAR/7z files and mod folders directly onto this window. Originals stay intact; uncertain mods require review."/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Separate Existing Mod Collections" Command="{Binding ReanalyzeManagedCollectionsCommand}"
                                            ToolTip="Inspect disabled library packages recursively and preview independent mods before copying them into their registered game libraries."/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Inspect Existing Mod Layouts" Command="{Binding InspectExistingModCollectionsCommand}"
                                            ToolTip="Read-only evidence for all tracked source packages, including unknown or incomplete nested mod groups."/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Add Game" Command="{Binding AddGameCommand}"
                                            ToolTip="Select a game executable to register it and switch to its mod library."/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Game Settings" Command="{Binding ConfigureGameCommand}"/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Open This Game's Mod Folder" Command="{Binding OpenGameModFolderCommand}"/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Open Downloaded Mod Archives" Command="{Binding OpenGameDownloadsFolderCommand}"/>
                                    <Expander Header="More tools" Margin="4,10,4,0" Foreground="{StaticResource Text}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Find Mod Causing Startup Crash" Command="{Binding AutoDiagnoseCrashCommand}"/>
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left"
                                    Content="Open Heaven.gg Game Hub" Command="{Binding OpenHeavenGameGuideCommand}"
                                    ToolTip="Opens a read-only public game guide in your browser; never changes local game files."
                                    AutomationProperties.Name="Open public Heaven.gg game guide"/>
                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Export Mod List" Command="{Binding ExportRecipeCommand}"/>
                                            <Button Margin="0" HorizontalContentAlignment="Left" Content="Advanced Tools &amp; Diagnostics" Command="{Binding OpenWorkflowsCommand}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Mods">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedLibraryItem.DisplayName, FallbackValue='Select a mod to see its sources and components.', TargetNullValue='Select a mod to see its sources and components.'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedLibraryItem.SourceSummary, StringFormat='Package sources: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedMod.PartsLabel, StringFormat='Components: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid HorizontalAlignment="Stretch">
                <Grid Margin="8,6,8,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" Style="{StaticResource PageTitle}"/>
                            <Border Margin="10,0,0,0" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Text="{Binding InstalledCountLabel,Mode=OneWay}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12"
                                   Text="{Binding ActiveGameDisplayName, StringFormat='Managed and discovered mods for {0}'}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Copy unmanaged files from this game profile's configured mod folder into a tracked source package without modifying the live tree."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,6,0,6" Style="{StaticResource SubtleCard}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="SEARCH MODS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="Ctrl+F"/>
                                </StackPanel>
                                <TextBox x:Name="ModSearchBox" Grid.Column="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search mods" ToolTip="Search mod name, add-on, category, source, or problem. Ctrl+F jumps here. Enter selects a result.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SubmitModSearchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusBadge}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding VisibleLibraryCount,Mode=OneWay}"/><Run Text=" shown · "/></TextBlock>
                                        <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="All mods"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Enabled"><Setter Property="Text" Value="Enabled"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Staged"><Setter Property="Text" Value="Pending changes"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Updates"><Setter Property="Text" Value="Updates"/></DataTrigger>
                                                         <DataTrigger Binding="{Binding ModViewMode}" Value="FamilyLinks"><Setter Property="Text" Value="Possible families"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Issues"><Setter Property="Text" Value="Problems"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Revalidate"><Setter Property="Text" Value="Needs check"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Superseded"><Setter Property="Text" Value="Not currently used"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <WrapPanel x:Name="ModLibraryToolbar" Grid.Row="1"
                                       Margin="0,8,0,0" Orientation="Horizontal"
                                       KeyboardNavigation.TabNavigation="Continue"
                                       AutomationProperties.Name="Mod list filters">
                                <TextBlock Text="FILTERS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,2,8,2"/>
                                <Button Content="{Binding AllViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="All" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show every mod in this library."/>
                                <Button Content="{Binding FamilySuggestionsViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="FamilyLinks" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Review possible parent/add-on relationships, including disabled mods. No package is linked or enabled automatically."/>
                                <Button Content="{Binding EnabledViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Enabled" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show mods enabled in the pending setup."/>
                                <Button Content="{Binding StagedViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Staged" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show unapplied changes."/>
                                <Button Content="{Binding UpdatesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Updates" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show mods with detected updates."/>
                                <Button Content="{Binding IssuesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Issues" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show mods with crash or graphics-problem evidence."/>
                                <Button Content="{Binding RevalidateViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Revalidate" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show mods requiring revalidation after a game update."/>
                                <Button Content="{Binding SupersededViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Superseded" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2" ToolTip="Show enabled mods whose files have been fully replaced."/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0" KeyboardNavigation.TabNavigation="Continue">
                                <TextBlock Text="BULK · VISIBLE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="Select All" Command="{Binding EnableVisibleCommand}" IsEnabled="{Binding HasVisibleMods}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Enable mods shown by the current filters." AutomationProperties.Name="Select all visible mods" AutomationProperties.HelpText="{Binding VisibleBulkScopeHelp}"/>
                                <Button Content="Deselect All" Command="{Binding DisableVisibleCommand}" IsEnabled="{Binding HasVisibleMods}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Disable mods shown by the current filters." AutomationProperties.Name="Deselect all visible mods" AutomationProperties.HelpText="{Binding VisibleBulkScopeHelp}"/>
                                <Button Content="{Binding RefreshVisibleLabel}" Command="{Binding ReindexVisibleCommand}" IsEnabled="{Binding HasVisibleMods}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5"
                                        ToolTip="{Binding VisibleBulkScopeHelp}"/>
                                <Button Content="Inspect Existing Mod Layouts" Command="{Binding InspectExistingModCollectionsCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="8,0,6,0"
                                        ToolTip="Read-only inspection of every tracked mod package. Show nested companion patterns, unclassified files and reasons without enabling, deleting or importing anything."
                                        AutomationProperties.Name="Inspect nested mod package layouts without making changes"/>
                                <TextBlock Text="{Binding VisibleBulkScopeHelp}" VerticalAlignment="Center" Margin="10,3,0,3" MaxWidth="520" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="ModLibraryRegion" Grid.Row="2">
                        <Border CornerRadius="9" ClipToBounds="True" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding LibraryView}" SelectedItem="{Binding SelectedLibraryItem,Mode=TwoWay}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowDetailsVisibilityMode="VisibleWhenSelected" RowHeight="58" AutomationProperties.Name="Mod library">
                            <DataGrid.ItemContainerStyleSelector>
                                <vm:LibraryRowStyleSelector>
                                    <vm:LibraryRowStyleSelector.ExternalStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridRow">
                                                    <Border Padding="12,5" Background="{TemplateBinding Background}" ToolTip="{Binding SourceSummary}">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding OwnerLabel}" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        </Style>
                                    </vm:LibraryRowStyleSelector.ExternalStyle>
                                </vm:LibraryRowStyleSelector>
                            </DataGrid.ItemContainerStyleSelector>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Margin="72,2,18,10" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Mod preview" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Cached Nexus artwork and screenshots found inside the source packages. Select a mod to load its gallery."/>
                                            <ItemsControl ItemsSource="{Binding GalleryPaths}" Margin="0,0,0,14">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="156" Height="102" Margin="0,0,8,8" CornerRadius="6" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                            <Image Source="{Binding Converter={StaticResource SafeImage},ConverterParameter=320}" Stretch="UniformToFill" AutomationProperties.Name="{Binding DataContext.DisplayName,RelativeSource={RelativeSource AncestorType=DataGridRow},StringFormat='Preview image for {0}'}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Margin="0,0,0,12" Padding="10" Background="#111923" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSuggestedParents}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="Possible parent relationships — review before linking" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                                    <TextBlock Text="Matching game paths do not prove mod dependency. These suggestions do not install or enable anything." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding SuggestedParents}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" MaxWidth="640"/>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Attach as add-on"
                                                                            Command="{Binding DataContext.ConfirmSuggestedFamilyCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Confirm a saved parent/add-on override relationship."
                                                                            AutomationProperties.Name="{Binding Title}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                             </Border>
                                             <TextBlock Text="Advanced mod options" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" FontSize="11" Text="The main toggle controls the whole mod. Open these options only when you want to turn individual add-ons or components on or off."/>
                                            <ItemsControl ItemsSource="{Binding Parts}" IsEnabled="{Binding CanStage}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Padding="7,2" CornerRadius="9" BorderBrush="#303844" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource AccentBright}"/></Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding NexusLabel}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ENABLED" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <CheckBox IsEnabled="{Binding CanStage}" IsChecked="{Binding StagedEnabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                          IsThreeState="False"
                                                          HorizontalAlignment="Center"
                                                          AutomationProperties.Name="{Binding DisplayName}"
                                                          AutomationProperties.HelpText="Turn this mod on or off. Manager verifies and applies eligible changes automatically."
                                                          ToolTip="Turn this mod on or off. Manager verifies and applies eligible changes automatically. A partial state means only some add-ons or components are enabled."/>
                                                <TextBlock Margin="0,3,0,0"
                                                           Text="{Binding PendingStateLabel}"
                                                           Foreground="{StaticResource Warn}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="76" Height="48" CornerRadius="5" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="IMG" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailPath,Converter={StaticResource SafeImage},ConverterParameter=160}" Stretch="UniformToFill" AutomationProperties.Name="{Binding DisplayName,StringFormat='Thumbnail for {0}'}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MOD" Width="2.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding FamilyHint}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}"/>
                                                <TextBlock Text="{Binding IssueBadge}" Foreground="{StaticResource Warn}" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding IssueReason}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding UpdateBadge}" Foreground="{StaticResource Good}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="Enabled">
                                                                <Setter Property="Background" Value="#13241C"/>
                                                                <Setter Property="BorderBrush" Value="#28553E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasStagedChanges}" Value="True">
                                                                <Setter Property="Background" Value="#272113"/>
                                                                <Setter Property="BorderBrush" Value="#5B4720"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="Enabled"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding HasStagedChanges}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBright}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="IN GAME" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding EffectiveReason}">
                                                <TextBlock Text="{Binding EffectLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding WinningFiles,Mode=OneWay}"/><Run Text=" winning • "/><Run Text="{Binding ShadowedFiles,Mode=OneWay}"/><Run Text=" shadowed"/></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="125" IsReadOnly="True"/>
                                <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="76" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="INSTALLED FROM" Width="1.2*" SortMemberPath="SourceSummary">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding CheckingDiscoveredLibrary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="16,8">
                                <TextBlock Text="Your mod library is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Install a downloaded mod archive, or bring existing manual mod files into the manager."/>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Choose a downloaded mod archive and add it to this game's library."/>
                                    <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" ToolTip="Copy unmanaged files from the configured mod folder into a tracked source package without modifying the live tree."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleLibraryCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="16,8">
                                <TextBlock Text="No mods match this view" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Your mods are still here. Clear the search and filters to show everything again."/>
                                <Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="Clear filters" Command="{Binding ClearModFiltersCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource SubtleCard}" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource Text}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding StagedSummary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PlanPreviewText}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Review and retry" Command="{Binding ApplyCommand}" Visibility="{Binding ReviewRetryVisibility}" ToolTip="Review a held change and retry after resolving its cause."/>
                                <Button Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="See exactly what would change without editing game files." IsEnabled="{Binding HasStagedChanges}" AutomationProperties.HelpText="{Binding PendingActionsHelp}"/>
                                <Button Content="Discard Pending Changes" Command="{Binding DiscardStagedCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Discard all pending enable/disable changes. Installed game files are not changed." IsEnabled="{Binding HasStagedChanges}" AutomationProperties.HelpText="{Binding PendingActionsHelp}"/>
                                <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="10,5" Margin="2,0" ToolTip="Restore the previous applied mod setup. Ctrl+Z." AutomationProperties.Name="Undo Last Applied Change"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding CoverageTabLabel}">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CoverageTitle}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding CoverageSubtitle}" Style="{StaticResource PageSubtitle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSemanticCoverage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></StackPanel.Style>
                                <Button Content="View mod options" Command="{Binding SetModViewCommand}" CommandParameter="All"/>
                                <Button Content="See shared files" Command="{Binding ShowOverlapsCommand}"/>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding OutfitRows}" SelectedItem="{Binding SelectedOutfit,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="88" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="126,4,18,12" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                    <TabControl AutomationProperties.Name="Armor details and outfit options" SelectedIndex="{Binding DataContext.OutfitDetailsTab,RelativeSource={RelativeSource AncestorType=Window},Mode=TwoWay}">
                                        <TabItem Header="Outfit options">
                                            <StackPanel Margin="12">
                                                <TextBlock Text="{Binding Armor}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choosing an outfit enables its package and uses its model, materials and textures for the armor pieces it supplies." TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,6" Text="No indexed outfits are available for this armor.">
                                                    <TextBlock.Style><Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Available}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <DockPanel Margin="0,4">
                                                            <Button DockPanel.Dock="Right" Content="Use outfit" Command="{Binding DataContext.ChooseOutfitCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName,StringFormat='Use outfit {0}'}"/>
                                                            <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="Use normal load order" HorizontalAlignment="Left" IsEnabled="{Binding HasPreference}"
                                                        ToolTip="Remove the preference for this armor. Enabled packages stay available."
                                                        Command="{Binding DataContext.ClearOutfitChoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </TabItem>
                                        <TabItem Header="Details">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="250" Height="160" CornerRadius="7" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                                            <Grid>
                                                <TextBlock Text="No visual available" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=512}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Armor,StringFormat='Preview image for {0}'}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,2,0,0">
                                            <TextBlock Text="{Binding Armor}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" Text="{Binding ModelId}"/>
                                            <TextBlock Text="Supplying mods" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Text="{Binding Providers}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="Winning pieces" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding WinningPieces}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="LOOK" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="108" Height="72" CornerRadius="6" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="No preview" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=224}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Armor,StringFormat='Preview image for {0}'}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ARMOR" Binding="{Binding Armor}" Width="1.8*"/>
                            <DataGridTextColumn Header="MODEL" Binding="{Binding ModelId}" Width="110"/>
                            <DataGridTemplateColumn Header="OPTIONS" Width="135">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Button Content="{Binding OptionsLabel}" AutomationProperties.Name="{Binding Armor,StringFormat='View outfits for {0}'}"
                                            Command="{Binding DataContext.ShowOutfitOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="USED PIECES" Binding="{Binding WinningPieces}" Width="1.4*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Needs attention">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedConflict.Scope, FallbackValue='Select a conflict to see its evidence.', TargetNullValue='Select a conflict to see its evidence.', StringFormat='Affected files: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedConflict.Providers, StringFormat='Providers: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedConflict.Evidence, StringFormat='Evidence: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Needs attention" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#2B2114" BorderBrush="#59401F" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource Warn}" FontSize="11" FontWeight="Bold"><Run Text="{Binding BlockerCount,Mode=OneWay}"/><Run Text=" conflicts • "/><Run Text="{Binding IssueCount,Mode=OneWay}"/><Run Text=" problem clues"/></TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Review mod conflicts and clues from recent crashes. Problem marks never disable or delete a mod; they only help you narrow down what to check." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Report game crash" Command="{Binding ReportGameCrashCommand}" ToolTip="Record that the game crashed so the manager can compare recently changed mods with the last successful launch."/>
                            <Button Content="Report GPU/graphics crash" Command="{Binding ReportGpuGraphicsCrashCommand}" Style="{StaticResource AttentionButton}" ToolTip="Record a graphics-related crash so recently changed graphics and texture mods can be checked first."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Suspected problem mods" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Added after a failed startup or a crash you report. Stronger evidence means a mod is worth checking first, but it does not prove the mod caused the crash." TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding IssueSuspects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="9" Background="#11161C" BorderBrush="#413520" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Warn}" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FailureLabel}"/><TextBlock Text="{Binding LastSeen}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#D0D5DB" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Grid.Column="4" Content="Clear mark" Command="{Binding DataContext.ClearIssueSuspectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ModId}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName,StringFormat='Clear problem mark for {0}'}" ToolTip="Remove this problem clue. The mod and game files are not changed."/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Good}" FontSize="11" Text="No mods are currently flagged for investigation.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IssueCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                    <DataGrid ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Unresolved conflicts">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISSUE" Binding="{Binding Kind}" Width="145"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="FILES" Binding="{Binding FileCountLabel}" Width="70"/>
                            <DataGridTextColumn Header="AFFECTED CONTENT" Binding="{Binding Scope}" Width="2.2*"/>
                            <DataGridTextColumn Header="WHAT'S HAPPENING" Binding="{Binding Explanation}" Width="3*"/>
                            <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding BlockerCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No unresolved conflict choices" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The pending setup has no mod conflicts that need your choice."/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Border Grid.Row="3" Padding="14">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedConflict}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Choose which mod should win" FontWeight="SemiBold"/>
                            <TextBlock Text="Unrelated mods can still target the same armor slot. Review Technical details for exact overlapping files versus broader model/material dependency risk. Choose one if they are alternatives. Only mark main and add-on when that relationship and compatibility are verified." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Expander Header="Technical details" Margin="0,0,0,10" Foreground="{StaticResource Muted}">
                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedConflict.Evidence}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding SelectedConflict.Options}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Padding="10" MinWidth="190" MaxWidth="230" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Border Width="170" Height="82" Background="#0B0F13" CornerRadius="6" Margin="0,0,0,7" ClipToBounds="True">
                                                    <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=384}" Stretch="UniformToFill" AutomationProperties.Name="{Binding DisplayName,StringFormat='Preview image for {0}'}"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="205"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#D0D5DB" TextWrapping="Wrap" MaxWidth="205" Margin="0,3,0,8"/>
                                                <Button Content="Use This Mod" Margin="0,0,0,6" Command="{Binding DataContext.ChooseConflictOptionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" Style="{StaticResource PrimaryButton}"/>
                                                <Button Content="Treat as Main Mod + Add-ons" Command="{Binding DataContext.ChainConflictFamilyCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" ToolTip="Manual override: use only after verifying the other packages really depend on this main mod. Sharing an armor slot is not proof of a family."/>
                                                <Button Content="Separate from this group"
                                                        Margin="0,7,0,0"
                                                        AutomationProperties.Name="{Binding DisplayName,StringFormat='Separate {0} from incorrect family'}"
                                                        Command="{Binding DataContext.SeparateConflictFamilyCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Token}"
                                                        ToolTip="Remove an incorrect family link without deleting the mod or touching installed game files. Remaining real conflicts will still require review.">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanSeparate}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Profiles">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedProfile.Name, FallbackValue='Select a saved profile to see its details.', TargetNullValue='Select a saved profile to see its details.', StringFormat='Profile: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedProfile.EnabledMods, StringFormat='Enabled mods: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedProfile.UpdatedAt, StringFormat='Last updated: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Save a complete mod setup and switch back to it later without rebuilding it by hand." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,20,0,12" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProfileName}" AutomationProperties.Name="New profile name" ToolTip="Name for the mod setup you are about to save."/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Save Current Setup" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Use Selected Profile" Command="{Binding StageProfileCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Saved profiles">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROFILE" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="ENABLED MODS" Binding="{Binding EnabledMods}" Width="140"/>
                                <DataGridTextColumn Header="UPDATED" Binding="{Binding UpdatedAt}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No saved profiles yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Name your current mod setup above, then choose Save Current Setup."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedActivity.Description, FallbackValue='Select an activity to see its support ID.', TargetNullValue='Select an activity to see its support ID.', StringFormat='Action: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedActivity.State, StringFormat='Status: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedActivity.Id, StringFormat='Support ID: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="History &amp; support" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="See what the manager changed and create diagnostics only when you need support." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Collect Diagnostics" Command="{Binding CaptureDiagnosticsCommand}"/>
                            <Button Content="View Log" Command="{Binding OpenMasterLogCommand}"
                                    ToolTip="Open local debug log; review private mod paths before sharing."/>
                            <Button Content="Performance Report" Command="{Binding ExportPerformanceReportCommand}"
                                    ToolTip="Open p50/p95 timing, CPU and allocation measurements for recent operations."/>
                            <Button Content="Create Support Bundle" Command="{Binding ExportSupportCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,10">
                        <DataGrid SelectedItem="{Binding SelectedActivity,Mode=TwoWay}" ItemsSource="{Binding ActivityRows}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Recent activity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="WHEN" Binding="{Binding Started}" Width="190"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="120"/>
                                <DataGridTextColumn Header="ACTION" Binding="{Binding Description}" Width="2.5*"/>
                                <DataGridTextColumn Header="SUPPORT ID" Binding="{Binding Id}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ActivityRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No activity recorded yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Applied changes, restores, and support actions will appear here."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Text="Support bundles contain logs and troubleshooting details, not your mod files or large game files."/>
                </Grid>
            </TabItem>

            <TabItem Header="Shared Files">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedOverlap.PrimaryPath, FallbackValue='Select a shared file to see its path and providers.', TargetNullValue='Select a shared file to see its path and providers.', StringFormat='File: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedOverlap.Providers, StringFormat='Providers: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedOverlap.Detail, StringFormat='Result: {0}'}"/>
                            <Button Content="Explain selected file" Command="{Binding ExplainSelectedOverlapCommand}" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOverlap}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Shared files" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#151A20" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="{Binding OverlapCount,Mode=OneWay}"/>
                                        <TextBlock Margin="4,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="shared assets"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="See when more than one mod changes the same game file. The manager handles safe cases automatically and explains the result when you want details." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Why This Mod Wins" Command="{Binding ExplainSelectedOverlapCommand}" ToolTip="Explain which mod supplies this shared file and why. Technical evidence is included below."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Sharing a file is not always a problem. Select a row to see which mod is being used and why; unresolved choices appear in Needs Attention instead of being guessed."/>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding OverlapRows}" SelectedItem="{Binding SelectedOverlap,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Asset overlaps">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GAME FILE" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding ProviderCount}" Width="90"/>
                                <DataGridTextColumn Header="RESULT" Binding="{Binding Resolution}" Width="140"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="3*"/>
                                <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding OverlapCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No shared files detected" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The enabled mods in this setup are not competing for the same files."/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Why this file uses this mod" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="{Binding ExplainWhyStatus}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,3" CornerRadius="11" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedExplanation.RuleSource}"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Summary}"/>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="FILE PATH"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedExplanation.Path}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="TECHNICAL REASON"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.ReasonCode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="CONFIDENCE"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Confidence}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="AUTOMATION SCORE"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedExplanation.ResolverScore}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="EXPLANATION"/>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Explanation}"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="EVIDENCE"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Evidence}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="4" Margin="0,12,0,0" MaxHeight="150" ItemsSource="{Binding SelectedExplanation.Providers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MOD" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="WILL USE" Binding="{Binding PlannedWinner}" Width="82"/>
                                    <DataGridCheckBoxColumn Header="IN USE" Binding="{Binding AppliedProvider}" Width="82"/>
                                    <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="72"/>
                                    <DataGridTextColumn Header="FAMILY" Binding="{Binding FamilyId}" Width="1.4*"/>
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding FamilyRole}" Width="100"/>
                                    <DataGridTextColumn Header="NEXUS MOD" Binding="{Binding NexusModId}" Width="100"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding ProvenanceSource}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=CurrentProgramBuildText, StringFormat='Installed build: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=ProgramUpdateStatus, StringFormat='Update status: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=StorageStatusText, StringFormat='Storage: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,30,36,36" MaxWidth="980" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Choose how the manager updates itself, refreshes mod information, and asks before important actions. Changes are saved automatically." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <Border Margin="0,22,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Program updates" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Margin="0,4,0,12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Automatic updates stay verified and use the existing safe restart handoff. Turn them off if you prefer to decide when the manager checks and installs."/>
                                <CheckBox Content="Automatically check for and install verified program updates"
                                          IsChecked="{Binding AutoUpdateEnabled,Mode=TwoWay}"
                                          AutomationProperties.Name="Automatic program updates"/>
                                <TextBlock Margin="24,6,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding ProgramUpdateStatus}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Check for updates now" Command="{Binding CheckForProgramUpdatesCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8"/>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding CurrentProgramBuildText}"/>
                                        <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding LatestProgramBuildText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Interface" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Margin="0,12,0,0" Content="Use interface animations and transitions"
                                          IsChecked="{Binding UiAnimationsEnabled,Mode=TwoWay}"
                                          AutomationProperties.Name="Interface animations"/>
                                <TextBlock Margin="24,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="Turn this off for instant page, hover, and dialog transitions."/>
                                <CheckBox Margin="0,14,0,0" Content="Remember the last tab I used"
                                          IsChecked="{Binding RememberLastTab,Mode=TwoWay}"
                                          AutomationProperties.Name="Remember last tab"/>
                                <TextBlock Margin="24,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="When disabled, the manager always opens on Dashboard."/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Safety confirmations" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Margin="0,12,0,0" Content="Ask before applying pending mod changes"
                                          IsChecked="{Binding ConfirmBeforeApply,Mode=TwoWay}"
                                          AutomationProperties.Name="Confirm before apply"/>
                                <TextBlock Margin="24,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="Adds a final confirmation before the manager writes an approved deployment to the game."/>
                                <CheckBox Margin="0,14,0,0" Content="Ask before discarding pending changes"
                                          IsChecked="{Binding ConfirmBeforeDiscardStaged,Mode=TwoWay}"
                                          AutomationProperties.Name="Confirm before discard"/>
                                <TextBlock Margin="24,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="Helps prevent accidental loss of staged enable, disable, and priority changes."/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Background refresh" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Margin="0,12,0,0" Content="Refresh mod metadata periodically in the background"
                                          IsChecked="{Binding BackgroundMetadataRefreshEnabled,Mode=TwoWay}"
                                          AutomationProperties.Name="Background metadata refresh"/>
                                <TextBlock Margin="24,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="When enabled, cached lineage, visuals, and update metadata can refresh about every four hours while the manager is idle. Opening Mods can still refresh information on demand."/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Privacy &amp; legal" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Margin="0,4,0,12"
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Text="This release is local-first: no first-party account, ads, browser cookies, in-app payments, consumer-review system, or marketing email. Network features contact only the configured update/mod providers needed for those features."/>
                                <WrapPanel Margin="-4,0,0,0">
                                    <Button Content="Privacy policy" Command="{Binding OpenPrivacyPolicyCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open privacy policy"/>
                                    <Button Content="Terms of use" Command="{Binding OpenTermsOfUseCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open terms of use"/>
                                    <Button Content="Refund policy" Command="{Binding OpenRefundPolicyCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open refund policy"/>
                                    <Button Content="Cookie policy" Command="{Binding OpenCookiePolicyCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open cookie policy"/>
                                </WrapPanel>
                                <WrapPanel Margin="-4,8,0,0">
                                    <Button Content="Third-party notices" Command="{Binding OpenThirdPartyNoticesCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open third-party notices"/>
                                    <Button Content="Data deletion instructions" Command="{Binding OpenDataDeletionGuideCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open data deletion instructions"/>
                                    <Button Content="Project &amp; support details" Command="{Binding OpenSupportDetailsCommand}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Open project and support details"/>
                                    <Button Content="Open app data folder" Command="{Binding OpenAppDataFolderCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Open manager data folder"/>
                                </WrapPanel>
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Project: Universal Mod Manager / MHW Manual Mod Manager • Publisher: fengie • Formal business-entity/address details are not invented; add them before any commercial release that legally requires them."/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding LegalStatusText}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Storage" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Margin="0,4,0,12"
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Text="See where manager-owned disk space is being used. Installed Mods, archived Mods, managed package data, and State are durable and are never removed by the reclaim action."/>
                                <ItemsControl ItemsSource="{Binding StorageCategories}"
                                              AutomationProperties.Name="Manager storage categories">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource AccentBright}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Retention}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Margin="8,0,0,0"
                                            Content="Reclaim disposable storage"
                                            Command="{Binding ReclaimDisposableStorageCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            AutomationProperties.Name="Reclaim disposable storage"/>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="Reclaim removes only updater-owned old orphan staging attempts and terminal recovery transactions already proven safe to discard. It preserves installed Mods, State, archives, catalog scratch, unknown files, live pending update data, nonterminal recovery data, and reparse paths."/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding StorageStatusText}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <TabItem Header="Browse Mods">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedCatalogItem.Provider, FallbackValue='Select a catalog item to see its source and install options.', TargetNullValue='Select a catalog item to see its source and install options.', StringFormat='Catalog provider: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedCatalogItem.Name, StringFormat='Mod: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=CatalogInstallGuidance, StringFormat='Install options: {0}'}"/>
                            <Button Content="Show provider files" Command="{Binding LoadCatalogFilesCommand}" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCatalogItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <Grid Margin="24,22,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Browse mods" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Search cached provider metadata, refresh supported sources, and install only an exact file you choose." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="More Cached"
                                    Command="{Binding LoadMoreCachedCatalogCommand}"
                                    Visibility="{Binding CatalogLoadMoreCachedVisibility}"
                                    AutomationProperties.Name="Show more cached catalog results"
                                    ToolTip="Load the next 1,000 locally indexed matches without contacting any provider."
                                    Style="{StaticResource QuietButton}"/>
                            <Button Content="Load More"
                                    Command="{Binding LoadMoreCatalogCommand}"
                                    Visibility="{Binding CatalogLoadMoreVisibility}"
                                    AutomationProperties.Name="Load more provider browse results"
                                    ToolTip="Resume supported provider browse pages from the last successfully persisted continuation."
                                    Style="{StaticResource QuietButton}"/>
                            <Button Content="Index All Available"
                                    Command="{Binding IndexAllAvailableModsCommand}"
                                    Visibility="{Binding CatalogLoadMoreVisibility}"
                                    AutomationProperties.Name="Index all available mods"
                                    ToolTip="Follow every supported provider continuation until all currently enumerable mods are stored in the local catalogue."
                                    Style="{StaticResource QuietButton}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SubtleCard}" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CatalogQuery,UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Search provider catalog"
                                             ToolTip="Typing filters the local cache. Press Enter or choose Search to query supported providers.">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCatalogCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Search"
                                            Command="{Binding SearchCatalogCommand}"
                                            Style="{StaticResource QuietButton}"
                                            ToolTip="Search supported provider APIs, then show matching cached results. Unsupported providers are not probed."/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="2,8,2,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding CatalogProviderSummary}" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource Muted}"
                                               FontSize="10"
                                               Text="{Binding CatalogCoverageSummary}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding CatalogCoverageSummary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                                    <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold"
                                               Text="{Binding CatalogResultCountLabel}"
                                               AutomationProperties.Name="{Binding CatalogResultCountLabel}"/>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SubtleCard}"
                                    Padding="10"
                                    AutomationProperties.Name="{Binding CatalogPresentationTitle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CatalogPresentationTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding CatalogPresentationDetail}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <WrapPanel Margin="0,8,0,0"
                                                   Visibility="{Binding CatalogProviderWebLinksVisibility}">
                                            <Button Content="Nexus website"
                                                    Command="{Binding OpenNexusBrowseCommand}"
                                                    Margin="0,0,8,4"
                                                    Style="{StaticResource QuietButton}"
                                                    AutomationProperties.Name="{Binding SelectedGame.DisplayName,StringFormat='Browse {0} mods on Nexus Mods'}"
                                                    ToolTip="Browse on the official provider site; this does not bypass in-app provider policy or index results."/>
                                            <Button Content="GameBanana website"
                                                    Command="{Binding OpenGameBananaBrowseCommand}"
                                                    Margin="0,0,8,4"
                                                    Style="{StaticResource QuietButton}"
                                                    AutomationProperties.Name="{Binding SelectedGame.DisplayName,StringFormat='Browse {0} mods on GameBanana'}"
                                                    ToolTip="Browse on the official provider site; this does not bypass in-app provider policy or index results."/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="Retry Providers"
                                            Command="{Binding RefreshCatalogCommand}"
                                            Visibility="{Binding CatalogProviderRetryVisibility}"
                                            Style="{StaticResource QuietButton}"
                                            AutomationProperties.Name="Retry failed catalog providers"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="3">
                                <DataGrid ItemsSource="{Binding CatalogItems}"
                                          SelectedItem="{Binding SelectedCatalogItem,Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowHeight="88"
                                          EnableRowVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True"
                                          Visibility="{Binding CatalogResultsVisibility}"
                                          AutomationProperties.Name="Provider catalog results">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="MOD" Width="2.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,5,10,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="74"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="64" Height="64" CornerRadius="8" Background="#0A1018" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="No image" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Name,StringFormat='Thumbnail for {0}'}"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Margin="0,3,0,0" Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="10" MaxHeight="30" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Author}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                                                <TextBlock Text="  •  " Foreground="{StaticResource Muted}" FontSize="10"/>
                                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBright}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                                                <TextBlock Text="  •  " Foreground="{StaticResource Muted}" FontSize="10"/>
                                                                <TextBlock Text="{Binding Downloads}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                                <TextBlock Text=" downloads" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="SOURCE" Binding="{Binding Provider}" Width="105"/>
                                        <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="100"/>
                                        <DataGridTextColumn Header="UPDATED" Binding="{Binding Updated}" Width="135"/>
                                        <DataGridTextColumn Header="CACHE" Binding="{Binding CacheState}" Width="145"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Style="{StaticResource SubtleCard}"
                                        Padding="26"
                                        Visibility="{Binding CatalogEmptyVisibility}"
                                        AutomationProperties.Name="Browse Mods result state">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                        <TextBlock Text="{Binding CatalogEmptyTitle}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding CatalogEmptyDetail}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Clear Search"
                                                    Command="{Binding ClearCatalogSearchCommand}"
                                                    Visibility="{Binding CatalogClearSearchVisibility}"
                                                    Style="{StaticResource QuietButton}"
                                                    AutomationProperties.Name="Clear catalog search"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid Visibility="{Binding CatalogEmptyVisibility}"
                                      AutomationProperties.Name="No catalog results to inspect"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="310">
                                        <TextBlock Text="{Binding CatalogEmptyTitle}"
                                                   Style="{StaticResource SectionTitle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{Binding CatalogEmptyDetail}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Grid AutomationProperties.Name="Select a catalog mod to view details"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedCatalogItem}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding HasCatalogResults}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="310">
                                        <TextBlock Text="Select a mod to see details and exact files."
                                                   Style="{StaticResource SectionTitle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="Choose a result on the left. Installation stays unavailable until you select one exact provider file."
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Grid AutomationProperties.Name="Selected catalog mod details">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCatalogItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="72" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" Background="#0A1018" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="No image" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding SelectedCatalogItem.ThumbnailUri}" Stretch="UniformToFill" AutomationProperties.Name="{Binding SelectedCatalogItem.Name,StringFormat='Selected mod artwork for {0}'}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding SelectedCatalogItem.Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding SelectedCatalogItem.Provider,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedCatalogItem.Author,Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="10">
                                                <Run Text="Version "/><Run Text="{Binding SelectedCatalogItem.Version,Mode=OneWay}"/><Run Text=" · Updated "/><Run Text="{Binding SelectedCatalogItem.Updated,Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,10,0,0" Text="{Binding SelectedCatalogItem.Summary}" TextWrapping="Wrap" MaxHeight="90"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                                        <Button Content="Load Exact Files"
                                                Command="{Binding LoadCatalogFilesCommand}"
                                                Style="{StaticResource QuietButton}"
                                                AutomationProperties.Name="Load exact provider files"/>
                                        <Button Content="Open Provider Page" Command="{Binding OpenCatalogSourceCommand}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Border Visibility="{Binding CatalogFileStateVisibility}"
                                                Style="{StaticResource SubtleCard}"
                                                Padding="14"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding CatalogFilePresentationTitle}"
                                                AutomationProperties.LiveSetting="Polite">
                                            <StackPanel HorizontalAlignment="Center" MaxWidth="330">
                                                <TextBlock Text="{Binding CatalogFilePresentationTitle}"
                                                           Style="{StaticResource SectionTitle}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,7,0,0"
                                                           Text="{Binding CatalogFilePresentationDetail}"
                                                           Foreground="{StaticResource Muted}"
                                                           FontSize="11"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <Button Margin="0,12,0,0"
                                                        Content="Retry Loading Files"
                                                        Command="{Binding LoadCatalogFilesCommand}"
                                                        Visibility="{Binding CatalogFileRetryVisibility}"
                                                        Style="{StaticResource QuietButton}"
                                                        AutomationProperties.Name="Retry loading exact provider files"/>
                                            </StackPanel>
                                        </Border>
                                        <DataGrid Visibility="{Binding CatalogFilesVisibility}"
                                                  ItemsSource="{Binding CatalogFiles}"
                                                  SelectedItem="{Binding SelectedCatalogFile,Mode=TwoWay}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  AutomationProperties.Name="Exact provider files">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="1.7*"/>
                                                <DataGridTextColumn Header="TYPE" Binding="{Binding Category}" Width="92"/>
                                                <DataGridTextColumn Header="VERSION" Binding="{Binding Version}" Width="90"/>
                                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="86"/>
                                                <DataGridTextColumn Header="UPLOADED" Binding="{Binding Uploaded}" Width="135"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                        <Button Content="Install Selected File"
                                                Command="{Binding InstallCatalogFileCommand}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Install selected catalog file"
                                                AutomationProperties.HelpText="{Binding CatalogInstallGuidance}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCatalogFile}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11"
                                                   Text="{Binding CatalogInstallGuidance}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding CatalogStatusText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Expander Grid.Row="2" Header="Installed catalog origin checks" Foreground="{StaticResource Text}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                       Text="Checks only the exact provider mod/file identity recorded at install time. Missing files or changed metadata require review; the manager never guesses a replacement." TextWrapping="Wrap"/>
                            <DataGrid MaxHeight="180"
                                      ItemsSource="{Binding CatalogOriginStatuses}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      AutomationProperties.Name="Installed catalog origin status">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOCAL MOD" Binding="{Binding ModId}" Width="1.4*"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Provider}" Width="105"/>
                                    <DataGridTextColumn Header="MOD ID" Binding="{Binding ProviderModId}" Width="115"/>
                                    <DataGridTextColumn Header="FILE ID" Binding="{Binding ProviderFileId}" Width="115"/>
                                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="175"/>
                                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Message}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Installed files">
                <TabItem.Tag>
                    <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <StackPanel>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedInstalledFile.Evidence, FallbackValue='Select an installed file to see its evidence and location.', TargetNullValue='Select an installed file to see its evidence and location.', StringFormat='Evidence: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedInstalledFile.Location, StringFormat='File location: {0}'}"/>
                            <TextBox Style="{StaticResource ContextDetailLine}" Text="{Binding Mode=OneWay, Path=SelectedInstalledFile.InstallationRoot, StringFormat='Registered installation: {0}'}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.Tag>
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding LocalModInventoryStatus}" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Label Target="{Binding ElementName=LocalModSearch}" Content="Search installed files across all games"/>
                        <TextBox x:Name="LocalModSearch" Text="{Binding LocalModQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <DataGrid SelectedItem="{Binding SelectedInstalledFile,Mode=TwoWay}" ItemsSource="{Binding VisibleLocalModLocations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Game" Binding="{Binding Game}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Library status" Binding="{Binding LibraryStatus}"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#090C10" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Good}" Margin="0,0,8,0"/>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding FooterText}"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="170" Height="4" IsIndeterminate="True" Visibility="{Binding BusyVisibility}"/>
            </Grid>
        </Border>

        <!-- Blocking operation overlay -->
        <Border x:Name="BusyOverlay"
                Grid.RowSpan="3"
                Background="#C30A0D11"
                Visibility="{Binding BusyVisibility}"
                IsVisibleChanged="OnBusyOverlayIsVisibleChanged"
                Panel.ZIndex="50">
            <Border x:Name="BusyDialogCard"
                    Width="470"
                    Padding="28"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDim}" HorizontalAlignment="Left">
                        <TextBlock Text="…" Foreground="{StaticResource AccentBright}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="0,16,0,0" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Text="{Binding BusyTitle}"/>
                    <TextBlock Margin="0,8,0,12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" LineHeight="19" Text="{Binding BusyDetail}"
                               AutomationProperties.Name="Current operation phase"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource Text}" FontSize="11" TextWrapping="Wrap"
                                   Text="{Binding BusyProgressSummary}" AutomationProperties.Name="Package and byte progress"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding BusyElapsedText}" AutomationProperties.Name="Operation elapsed time"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BusyProgressPercent}"
                                 IsIndeterminate="{Binding BusyProgressIndeterminate}"
                                 Height="6" AutomationProperties.Name="Completed package progress"/>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding BusyItemProgressVisibility}">
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11"
                                   Text="{Binding BusyItemProgressLabel}"/>
                        <ProgressBar Minimum="0" Maximum="100" Height="4"
                                     Value="{Binding BusyItemProgressPercent}"
                                     AutomationProperties.Name="Current package file and byte progress"/>
                    </StackPanel>
                    <TextBlock Margin="0,9,0,0" Foreground="{StaticResource Muted}" FontSize="10"
                               TextTrimming="CharacterEllipsis" Text="{Binding BusyOperationId}"
                               ToolTip="{Binding BusyOperationId}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="View Log" Command="{Binding OpenMasterLogCommand}"
                                ToolTip="Open the local operation log for troubleshooting." Margin="0,0,8,0"/>
                        <Button Content="Cancel" Command="{Binding CancelBusyCommand}"
                                Visibility="{Binding CancelVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
