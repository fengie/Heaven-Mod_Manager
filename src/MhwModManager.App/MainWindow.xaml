<Window x:Class="MhwModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1480" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshAnalysisNowCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="94"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Top command bar -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="43"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Left">
                        <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource AccentDim}" BorderBrush="#665020" BorderThickness="1">
                            <TextBlock Text="UM" Foreground="{StaticResource AccentBright}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Universal Mod Manager" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold"/>
                                <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="10" Background="#231F15" BorderBrush="#4A3A1E" BorderThickness="1">
                                    <TextBlock Text="{Binding CurrentProgramBuildText}" Foreground="{StaticResource AccentBright}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock MaxWidth="350" Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="12" Text="{Binding HeaderSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderSummary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Launch Game" Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Back up your saves, check the setup, and launch the game with your enabled mods."/>
                        <Button Content="Apply Mod Changes" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTip="Apply staged mod changes transactionally. Ctrl+Enter."/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GAME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame,Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Active game" ToolTip="Each game has an isolated mod library, database, rollback history, and conflict state."/>
                        <Button Content="Use This Game" Command="{Binding SwitchGameCommand}" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource QuietButton}" ToolTip="Choose a downloaded mod archive and add it to this game's library."/>
                        <Button Content="Find Installed Games" Command="{Binding ScanInstalledGamesCommand}" Style="{StaticResource QuietButton}" ToolTip="Discover installed Steam, Epic, and GOG games."/>
                        <Button Content="Add Game" Command="{Binding AddGameCommand}" Style="{StaticResource QuietButton}" ToolTip="Add any Windows game by choosing its executable."/>
                        <Button Content="Game Settings" Command="{Binding ConfigureGameCommand}" Style="{StaticResource QuietButton}"/>
                        <Button Content="Launch Without Mods" Command="{Binding LaunchSafeModeCommand}" Style="{StaticResource QuietButton}" ToolTip="Temporarily deploy no manager-controlled mods, launch, then restore."/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Sidebar + pages -->
        <TabControl Grid.Row="1" TabStripPlacement="Left" SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="Dashboard">
                <Grid HorizontalAlignment="Stretch">
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Width="{Binding ViewportWidth,ElementName=DashboardScroll}" MaxWidth="1324" HorizontalAlignment="Left">
                    <Grid Margin="30,28,34,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="See whether your setup is ready to play and what needs your attention." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="2" Margin="-5,19,-5,13">
                            <Border Style="{StaticResource Card}" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Good}" CornerRadius="3"/>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="ACTIVE MODS" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding EnabledCount}" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="mods enabled for this setup" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="#6FA6E8" CornerRadius="3"/>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="WORKING IN GAME" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding FullyEffectiveCount}" FontSize="32" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"><Run Text="{Binding ComposedCount,Mode=OneWay}"/><Run Text=" composed • "/><Run Text="{Binding RevalidationCount,Mode=OneWay}"/><Run Text=" revalidate"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Warn}" CornerRadius="3"/>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding BlockerCount}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,6,0,0"/>
                                        <TextBlock Text="problems that need a choice" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Accent}" CornerRadius="3"/>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="READY TO APPLY" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Text="{Binding StagedCount}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AccentBright}" Margin="0,6,0,0"/>
                                        <TextBlock Text="mod changes waiting to be installed" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="System status" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Is everything ready to play?" Style="{StaticResource PageSubtitle}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="9,4" CornerRadius="12" Background="#13241C" BorderBrush="#28553E" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="MANAGER" Foreground="{StaticResource Good}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Border Margin="0,18,0,0" Padding="14" Background="#0D1218" CornerRadius="7" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" LineHeight="20"/>
                                    </Border>
                                    <TextBlock Margin="0,13,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding GamePathText}"/>
                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding UnmanagedAdoptionLabel}"/>
                                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource AccentBright}" TextWrapping="Wrap" Text="{Binding ProgramUpdateStatus}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Text="{Binding LatestProgramBuildText}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Start here" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="The most useful actions for this game." Style="{StaticResource PageSubtitle}"/>
                                    <Button Margin="0,17,0,7" HorizontalContentAlignment="Left" Content="Launch Game" ToolTip="Back up saves, run the health gate, launch, observe, and track last-known-good state." Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}"/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Install Mods from Inbox" Command="{Binding ProcessInboxCommand}" ToolTip="Drop archives/folders into Inbox and let the manager classify/import them automatically."/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Restore Last Working Setup" Command="{Binding RestoreLastGoodCommand}"/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Find Mod Causing Startup Crash" Command="{Binding AutoDiagnoseCrashCommand}" ToolTip="Automatically bisects newly enabled mods. MHW may launch multiple times."/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Clean Up Duplicate Mods" Command="{Binding SmartCleanupCommand}"/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Export Mod List" Command="{Binding ExportRecipeCommand}"/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Advanced Tools &amp; Diagnostics" Command="{Binding OpenWorkflowsCommand}"/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}" ToolTip="Build the exact plan without writing live game files."/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Review Shared Files" Command="{Binding ShowOverlapsCommand}" ToolTip="See multi-provider assets without treating resolved overwrites as errors."/>
                                    <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Check for App Updates" Command="{Binding CheckForProgramUpdatesCommand}" ToolTip="Checks the verified program release feed. Network or authentication failures never block normal manager use."/>
                                    <Button Margin="0" HorizontalContentAlignment="Left" Content="Apply Mod Changes" Command="{Binding ApplyCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentDim}" VerticalAlignment="Top">
                                    <TextBlock Text="i" Foreground="{StaticResource AccentBright}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="How conflicts are handled" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19"
                                               Text="The manager resolves safe, obvious mod relationships automatically and asks you only when two unrelated mods really need a winner. Your saved choices are remembered, and technical file details stay available when you want them."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Mods">
                <Grid Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ContentPresenter}}" HorizontalAlignment="Stretch">
                <Grid Margin="28,20,32,20">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mods" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Style="{StaticResource StatusBadge}" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Text="{Binding InstalledCountLabel,Mode=OneWay}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Stage what you want active, inspect the result, then apply once." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <Button Content="Sync metadata" Command="{Binding SyncMetadataCommand}" Style="{StaticResource QuietButton}" ToolTip="Refresh Nexus/local lineage, cached thumbnails, update availability, and superseded revisions."/>
                            <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" ToolTip="Copy unmanaged files from this game profile's configured mod folder into a tracked source package without modifying the live tree."/>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,14,0,10" Style="{StaticResource SubtleCard}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="SEARCH MODS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="Ctrl+F"/>
                                </StackPanel>
                                <TextBox x:Name="ModSearchBox" Grid.Column="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search mods" ToolTip="Search logical mod, component, category, source package, issue reason, or family part. Ctrl+F jumps here."/>
                                <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusBadge}">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding VisibleModCount,Mode=OneWay}"/><Run Text=" shown · "/><Run Text="{Binding ModViewMode,Mode=OneWay}"/></TextBlock>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SMART VIEWS" Style="{StaticResource Eyebrow}" Margin="4,0,0,5"/>
                                    <WrapPanel>
                                            <Button Content="{Binding AllViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="All" Style="{StaticResource QuietButton}" ToolTip="Show the complete logical mod library."/>
                                            <Button Content="{Binding EnabledViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Enabled" Style="{StaticResource QuietButton}" ToolTip="Show mods staged on, including partial logical families."/>
                                            <Button Content="{Binding StagedViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Staged" Style="{StaticResource QuietButton}" ToolTip="Show only unapplied changes."/>
                                            <Button Content="{Binding UpdatesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Updates" Style="{StaticResource QuietButton}" ToolTip="Show mods with detected Nexus updates."/>
                                            <Button Content="{Binding IssuesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Issues" Style="{StaticResource QuietButton}" ToolTip="Show persisted crash/GPU suspects."/>
                                            <Button Content="{Binding RevalidateViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Revalidate" Style="{StaticResource QuietButton}" ToolTip="Show version-sensitive mods that need revalidation after a game update."/>
                                            <Button Content="{Binding SupersededViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Superseded" Style="{StaticResource QuietButton}" ToolTip="Show enabled logical mods that currently contribute zero effective files."/>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                    <TextBlock Text="BULK ACTIONS · VISIBLE MODS" Style="{StaticResource Eyebrow}" Margin="4,0,0,5"/>
                                    <WrapPanel>
                                        <Button Content="Enable Visible Mods" Command="{Binding EnableSelectedCommand}" ToolTip="Stage every mod currently visible in this search and smart view as enabled."/>
                                        <Button Content="Disable Visible Mods" Command="{Binding DisableSelectedCommand}" ToolTip="Stage every mod currently visible in this search and smart view as disabled."/>
                                        <Button Content="Refresh Mod Info" Command="{Binding ReindexSelectedCommand}" Style="{StaticResource QuietButton}" ToolTip="Re-index every mod currently visible in this search and smart view."/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Border CornerRadius="9" ClipToBounds="True" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding ModsView}" SelectedItem="{Binding SelectedMod,Mode=TwoWay}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="False" RowDetailsVisibilityMode="VisibleWhenSelected" RowHeight="58" AutomationProperties.Name="Mod library">
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Margin="72,2,18,10" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Mod preview" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Cached Nexus artwork and screenshots found inside the source packages. Select a mod to load its gallery."/>
                                            <ItemsControl ItemsSource="{Binding GalleryPaths}" Margin="0,0,0,14">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="156" Height="102" Margin="0,0,8,8" CornerRadius="6" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                            <Image Source="{Binding Converter={StaticResource SafeImage}}" Stretch="UniformToFill" ToolTip="{Binding}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Advanced mod options" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" FontSize="11" Text="The main toggle controls the whole mod. Open these options only when you want to turn individual add-ons or components on or off."/>
                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Padding="7,2" CornerRadius="9" BorderBrush="#303844" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource AccentBright}"/></Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding NexusLabel}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ENABLED" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding StagedEnabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" HorizontalAlignment="Center" ToolTip="Toggle the whole logical mod family. A partial state means an older profile had only some components enabled."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="76" Height="48" CornerRadius="5" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="IMG" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailPath,Converter={StaticResource SafeImage}}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MOD" Width="2.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding IdentityHint}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}"/>
                                                <TextBlock Text="{Binding IssueBadge}" Foreground="{StaticResource Warn}" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding IssueReason}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding UpdateBadge}" Foreground="{StaticResource Good}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="ON">
                                                                <Setter Property="Background" Value="#13241C"/>
                                                                <Setter Property="BorderBrush" Value="#28553E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasStagedChanges}" Value="True">
                                                                <Setter Property="Background" Value="#272113"/>
                                                                <Setter Property="BorderBrush" Value="#5B4720"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="ON"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding HasStagedChanges}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBright}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="IN GAME" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding EffectiveReason}">
                                                <TextBlock Text="{Binding EffectLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding WinningFiles,Mode=OneWay}"/><Run Text=" winning • "/><Run Text="{Binding ShadowedFiles,Mode=OneWay}"/><Run Text=" shadowed"/></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="125" IsReadOnly="True"/>
                                <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="76" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="INSTALLED FROM" Width="1.2*" SortMemberPath="SourceSummary">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="16,8">
                                <TextBlock Text="Your mod library is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Install a downloaded mod archive, or bring existing manual mod files into the manager."/>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Choose a downloaded mod archive and add it to this game's library."/>
                                    <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" ToolTip="Copy unmanaged files from the configured mod folder into a tracked source package without modifying the live tree."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleModCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="16,8">
                                <TextBlock Text="No mods match this view" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Your mods are still here. Clear the search and filters to show everything again."/>
                                <Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="Clear filters" Command="{Binding ClearModFiltersCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource SubtleCard}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" Text="{Binding StagedSummary}"/>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" Text="{Binding PlanPreviewText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}" Style="{StaticResource QuietButton}" ToolTip="Dry run: build the exact deployment plan without writing live game files."/>
                                <Button Content="Discard Pending Changes" Command="{Binding DiscardStagedCommand}" Style="{StaticResource QuietButton}" ToolTip="Return every logical mod to its currently applied state. No files are changed."/>
                                <Button Content="Apply Mod Changes" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Commit the staged plan transactionally. Ctrl+Enter."/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding CoverageTabLabel}">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CoverageTitle}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding CoverageSubtitle}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh coverage" Command="{Binding RefreshOutfitsCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding OutfitRows}" SelectedItem="{Binding SelectedOutfit,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="88" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="126,4,18,12" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="250" Height="160" CornerRadius="7" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                                            <Grid>
                                                <TextBlock Text="No visual available" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage}}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,2,0,0">
                                            <TextBlock Text="{Binding Armor}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" Text="{Binding ModelId}"/>
                                            <TextBlock Text="Supplying mods" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Text="{Binding Providers}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="Winning pieces" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding WinningPieces}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="LOOK" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="108" Height="72" CornerRadius="6" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="No preview" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage}}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ARMOR" Binding="{Binding Armor}" Width="1.8*"/>
                            <DataGridTextColumn Header="MODEL" Binding="{Binding ModelId}" Width="110"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Available}" Width="90"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="WINNING PIECES" Binding="{Binding WinningPieces}" Width="1.4*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Needs attention">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Needs attention" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#2B2114" BorderBrush="#59401F" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource Warn}" FontSize="11" FontWeight="Bold"><Run Text="{Binding BlockerCount,Mode=OneWay}"/><Run Text=" conflicts • "/><Run Text="{Binding IssueCount,Mode=OneWay}"/><Run Text=" suspects"/></TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Conflict choices and launch/crash suspects live here. Suspect marks never disable or delete a mod; they are evidence to help you find the culprit." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Report game crash" Command="{Binding ReportGameCrashCommand}" ToolTip="Rank mods from the last modded launch against the previous successful launch."/>
                            <Button Content="Report GPU/graphics crash" Command="{Binding ReportGpuGraphicsCrashCommand}" Style="{StaticResource AttentionButton}" ToolTip="Use after ERR12 / graphics-device / renderer failure. Texture-heavy newly changed mods receive additional suspicion weight."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Suspected problem mods" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Automatically populated after an observed startup failure, or when you report a later game/GPU crash. Higher scores mean stronger evidence, not certainty." TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding IssueSuspects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="9" Background="#11161C" BorderBrush="#413520" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Warn}" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FailureLabel}"/><TextBlock Text="{Binding LastSeen}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#D0D5DB" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Grid.Column="4" Content="Clear mark" Command="{Binding DataContext.ClearIssueSuspectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ModId}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" ToolTip="Dismiss this suspect mark only; no mod state or files are changed."/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Good}" FontSize="11" Text="No suspect mods are currently flagged.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IssueCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                    <DataGrid ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Unresolved conflicts">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISSUE" Binding="{Binding Kind}" Width="145"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="FILES" Binding="{Binding FileCountLabel}" Width="70"/>
                            <DataGridTextColumn Header="AFFECTED CONTENT" Binding="{Binding Scope}" Width="2.2*"/>
                            <DataGridTextColumn Header="WHAT'S HAPPENING" Binding="{Binding Explanation}" Width="3*"/>
                            <DataGridTextColumn Header="AUTOMATION CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding BlockerCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No unresolved conflict choices" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The current staged setup does not need a manual winner decision."/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Border Grid.Row="3" Padding="14">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedConflict}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Choose which mod should win" FontWeight="SemiBold"/>
                            <TextBlock Text="Use a single winner when these mods are alternatives. If one is the main mod and the others are add-ons, tell the manager that relationship instead so they can work together." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedConflict.Evidence}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SelectedConflict.Options}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Padding="10" MinWidth="190" MaxWidth="230" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Border Width="170" Height="82" Background="#0B0F13" CornerRadius="6" Margin="0,0,0,7" ClipToBounds="True">
                                                    <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="205"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#D0D5DB" TextWrapping="Wrap" MaxWidth="205" Margin="0,3,0,8"/>
                                                <Button Content="Use This Mod" Margin="0,0,0,6" Command="{Binding DataContext.ChooseConflictOptionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" Style="{StaticResource PrimaryButton}"/>
                                                <Button Content="Treat as Main Mod + Add-ons" Command="{Binding DataContext.ChainConflictFamilyCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" ToolTip="Persist this as the family main and attach the other conflicting packages as optional/component children."/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Profiles">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Save complete loadouts and stage them later without losing your current setup." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,20,0,12" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProfileName}" AutomationProperties.Name="New profile name" ToolTip="Name for the loadout you are about to save."/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Save current" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Stage selected" Command="{Binding StageProfileCommand}"/>
                                <Button Content="Refresh" Command="{Binding RefreshProfilesCommand}" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Saved profiles">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROFILE" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="ENABLED MODS" Binding="{Binding EnabledMods}" Width="140"/>
                                <DataGridTextColumn Header="UPDATED" Binding="{Binding UpdatedAt}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No saved profiles yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Name the current loadout above, then choose Save current."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="History &amp; support" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="See what the manager changed and create diagnostics only when you need support." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Refresh" Command="{Binding RefreshActivityCommand}" Style="{StaticResource QuietButton}"/>
                            <Button Content="Collect Diagnostics" Command="{Binding CaptureDiagnosticsCommand}"/>
                            <Button Content="Create Support Bundle" Command="{Binding ExportSupportCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,10">
                        <DataGrid ItemsSource="{Binding ActivityRows}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Recent activity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="WHEN" Binding="{Binding Started}" Width="190"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="120"/>
                                <DataGridTextColumn Header="ACTION" Binding="{Binding Description}" Width="2.5*"/>
                                <DataGridTextColumn Header="TECHNICAL ID" Binding="{Binding Id}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ActivityRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No activity recorded yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Transactions, recovery operations, and diagnostics will appear here."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Text="Support bundles contain logs, state summaries, and diagnostics—not your mod blobs or large game assets."/>
                </Grid>
            </TabItem>

            <TabItem Header="Shared Files">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Shared files" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#151A20" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="{Binding OverlapCount,Mode=OneWay}"/>
                                        <TextBlock Margin="4,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="shared assets"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="See when more than one mod changes the same game file. The manager handles safe cases automatically and explains the result when you want details." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Why This Mod Wins" Command="{Binding ExplainSelectedOverlapCommand}" ToolTip="Show winner, rule source, confidence, evidence, family/provenance and applied-state details for the selected overlap."/>
                            <Button Content="Refresh analysis" Command="{Binding RefreshAnalysisNowCommand}" ToolTip="F5"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Sharing a file is not always a problem. Select a row to see which mod is being used and why; unresolved choices appear in Needs Attention instead of being guessed."/>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding OverlapRows}" SelectedItem="{Binding SelectedOverlap,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Asset overlaps">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GAME FILE" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding ProviderCount}" Width="90"/>
                                <DataGridTextColumn Header="RESULT" Binding="{Binding Resolution}" Width="140"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="3*"/>
                                <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding OverlapCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No shared files detected" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The enabled mods in this setup are not competing for the same files."/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Why this file uses this mod" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="{Binding ExplainWhyStatus}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,3" CornerRadius="11" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedExplanation.RuleSource}"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Summary}"/>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="FILE PATH"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedExplanation.Path}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="TECHNICAL REASON"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.ReasonCode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="CONFIDENCE"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Confidence}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="AUTOMATION SCORE"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedExplanation.ResolverScore}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="EXPLANATION"/>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Explanation}"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="EVIDENCE"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Evidence}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="4" Margin="0,12,0,0" MaxHeight="150" ItemsSource="{Binding SelectedExplanation.Providers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MOD" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="WILL USE" Binding="{Binding PlannedWinner}" Width="82"/>
                                    <DataGridCheckBoxColumn Header="IN USE" Binding="{Binding AppliedProvider}" Width="82"/>
                                    <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="72"/>
                                    <DataGridTextColumn Header="FAMILY" Binding="{Binding FamilyId}" Width="1.4*"/>
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding FamilyRole}" Width="100"/>
                                    <DataGridTextColumn Header="NEXUS MOD" Binding="{Binding NexusModId}" Width="100"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding ProvenanceSource}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#090C10" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Good}" Margin="0,0,8,0"/>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding FooterText}"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="170" Height="4" IsIndeterminate="True" Visibility="{Binding BusyVisibility}"/>
            </Grid>
        </Border>

        <!-- Blocking operation overlay -->
        <Border Grid.RowSpan="3" Background="#C30A0D11" Visibility="{Binding BusyVisibility}" Panel.ZIndex="50">
            <Border Width="470" Padding="28" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDim}" HorizontalAlignment="Left">
                        <TextBlock Text="…" Foreground="{StaticResource AccentBright}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="0,16,0,0" FontSize="21" FontWeight="SemiBold" Text="{Binding BusyTitle}"/>
                    <TextBlock Margin="0,8,0,18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Text="{Binding BusyDetail}"/>
                    <ProgressBar IsIndeterminate="True" Height="5"/>
                    <Button Margin="0,18,0,0" HorizontalAlignment="Right" Content="Cancel" Command="{Binding CancelBusyCommand}" Visibility="{Binding CancelVisibility}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
