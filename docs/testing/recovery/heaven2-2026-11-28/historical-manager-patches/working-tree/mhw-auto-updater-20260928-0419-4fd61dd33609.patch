+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        ArgumentNullException.ThrowIfNull(bytes);
+        if (bytes.LongLength == 0 || bytes.LongLength > UpdateConstants.MaxManifestBytes)
+            throw new InvalidDataException("Update manifest size is invalid.");
+        UpdateManifest manifest;
+        try
+        {
+            manifest = JsonSerializer.Deserialize<UpdateManifest>(bytes, UpdateJson.CreateOptions())
+                       ?? throw new InvalidDataException("Update manifest is empty.");
+        }
+        catch (JsonException ex)
+        {
