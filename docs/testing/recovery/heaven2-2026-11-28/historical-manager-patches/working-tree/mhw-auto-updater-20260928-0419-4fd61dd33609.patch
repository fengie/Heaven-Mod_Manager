+        var installedManifest = Path.Combine(state.Paths.InstallRoot, UpdateConstants.PayloadManifestName);
+        var manifestHash = await HashFileAsync(installedManifest, ct).ConfigureAwait(false);
+        if (!manifestHash.Equals(pending.Manifest.PayloadManifestSha256, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("Installed payload manifest hash mismatch.");
+    }
+
+    private static async Task<string> HashFileAsync(string path, CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await using var stream = new FileStream(
+            path, FileMode.Open, FileAccess.Read, FileShare.Read, 256 * 1024,
+            FileOptions.Asynchronous | FileOptions.SequentialScan);
+        return Convert.ToHexString(await SHA256.HashDataAsync(stream, ct).ConfigureAwait(false));
+    }
+
+    private static void EnsureRollbackCapacity(string rollbackRoot, ProductPayloadManifest previous)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        try
+        {
+            var root = Path.GetPathRoot(Path.GetFullPath(rollbackRoot));
+            if (string.IsNullOrWhiteSpace(root)) return;
+            var required = checked(previous.Files.Sum(static x => x.Size) + 512L * 1024 * 1024);
+            if (new DriveInfo(root).AvailableFreeSpace < required)
+                throw new IOException(
+                    $"Not enough free space for updater rollback. Need at least {required} bytes.");
+        }
+        catch (ArgumentException)
+        {
