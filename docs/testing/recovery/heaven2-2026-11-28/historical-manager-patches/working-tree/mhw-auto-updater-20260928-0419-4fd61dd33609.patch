+using System.Security.Cryptography;
+using System.Text;
+using MhwModManager.Core;
+
+namespace MhwModManager.Updater;
+
+public static class UpdatePathSafety
+{
+    private static readonly string[] ProtectedRootNames =
+    [
+        "State",
+        "Mods",
+        "Inbox",
+        "Mods Archive",
+        "Games",
+        "BuildLogs"
+    ];
+
+    public static string NormalizePayloadPath(string relativePath)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        if (!PathRules.IsSafeArchiveRelativePath(relativePath))
+            throw new InvalidDataException($"Unsafe updater payload path: {relativePath}");
+        var normalized = relativePath.Replace('/', '\\');
+        var segments = normalized.Split('\\');
+        if (segments.Any(static segment => segment.Length == 0))
+            throw new InvalidDataException($"Updater payload path has an empty segment: {relativePath}");
+        if (ProtectedRootNames.Contains(segments[0], StringComparer.OrdinalIgnoreCase))
+            throw new InvalidDataException($"Updater payload path targets protected user data: {relativePath}");
+        if (normalized.Equals("MHW-DEBUG-ALL.log", StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("The mutable root debug log is not updater-owned.");
+        return normalized;
+    }
+
+    public static string GetContainedPath(string root, string relativePath)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var normalized = NormalizePayloadPath(relativePath);
+        var fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar);
+        var full = Path.GetFullPath(Path.Combine(fullRoot, normalized));
+        var prefix = fullRoot + Path.DirectorySeparatorChar;
+        if (!full.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException($"Updater path escapes trusted root: {relativePath}");
+        return full;
+    }
+
+    public static void EnsureExistingRootIsPhysical(string root)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar);
+        if (!Directory.Exists(fullRoot))
+            throw new DirectoryNotFoundException($"Updater trusted root does not exist: {fullRoot}");
+        if ((File.GetAttributes(fullRoot) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidDataException($"Updater trusted root is a reparse point: {fullRoot}");
+    }
+
+    public static void EnsureDirectoryTreeSafe(string directory)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var full = Path.GetFullPath(directory).TrimEnd(Path.DirectorySeparatorChar);
+        var root = Path.GetPathRoot(full);
+        if (string.IsNullOrWhiteSpace(root) || !Directory.Exists(root))
+            throw new DirectoryNotFoundException($"Updater path root does not exist: {full}");
+        var current = root.TrimEnd(Path.DirectorySeparatorChar);
+        if ((File.GetAttributes(root) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidDataException($"Updater filesystem root is a reparse point: {root}");
+
+        foreach (var segment in Path.GetRelativePath(root, full)
+                     .Split(Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries))
+        {
+            current = Path.Combine(current, segment);
+            if (Directory.Exists(current))
+            {
+                if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidDataException($"Updater path traverses a reparse point: {current}");
+                continue;
+            }
+
+            Directory.CreateDirectory(current);
+            if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException($"Updater path traverses a reparse point: {current}");
+        }
+    }
+
+    public static void EnsureSafeDirectoryPath(string root, string directory)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar);
+        var target = Path.GetFullPath(directory).TrimEnd(Path.DirectorySeparatorChar);
+        var prefix = fullRoot + Path.DirectorySeparatorChar;
+        if (!target.Equals(fullRoot, StringComparison.OrdinalIgnoreCase) &&
+            !target.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException($"Updater directory escapes trusted root: {target}");
+
+        EnsureExistingRootIsPhysical(fullRoot);
+        if (target.Equals(fullRoot, StringComparison.OrdinalIgnoreCase)) return;
+
+        var current = fullRoot;
+        foreach (var segment in Path.GetRelativePath(fullRoot, target)
+                     .Split(Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries))
+        {
+            current = Path.Combine(current, segment);
+            if (Directory.Exists(current))
+            {
+                if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidDataException($"Updater path traverses a reparse point: {current}");
+                continue;
+            }
+
+            Directory.CreateDirectory(current);
+            if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException($"Updater path traverses a reparse point: {current}");
+        }
+    }
+
+    public static void EnsureSafeFileDestination(string root, string destination)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var fullRoot = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar);
+        var full = Path.GetFullPath(destination);
+        var prefix = fullRoot + Path.DirectorySeparatorChar;
+        if (!full.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException($"Updater file escapes trusted root: {destination}");
+        var parent = Path.GetDirectoryName(full) ??
+                     throw new InvalidDataException($"Updater destination has no parent: {destination}");
+        EnsureSafeDirectoryPath(fullRoot, parent);
+        if (File.Exists(full) && (File.GetAttributes(full) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidDataException($"Updater destination is a reparse point: {full}");
+    }
+
+    public static string InstallationInstanceId(string installRoot)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var canonical = Path.GetFullPath(installRoot)
+            .TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
+            .ToUpperInvariant();
+        return Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(canonical)))[..24].ToLowerInvariant();
+    }
+
+    public static bool IsProtectedUserPath(string relativePath)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var normalized = relativePath.Replace('/', '\\').TrimStart('\\');
+        var first = normalized.Split('\\', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
+        return first is not null &&
+               ProtectedRootNames.Contains(first, StringComparer.OrdinalIgnoreCase);
+    }
+
+    public static void DeleteOwnedTreeSafe(string directory)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        if (!Directory.Exists(directory)) return;
+        EnsureExistingRootIsPhysical(directory);
+        var directories = new List<string>();
+        var pending = new Stack<string>();
+        pending.Push(directory);
+        while (pending.Count > 0)
+        {
+            var current = pending.Pop();
+            directories.Add(current);
+            foreach (var child in Directory.EnumerateFileSystemEntries(current))
+            {
+                var attributes = File.GetAttributes(child);
+                if ((attributes & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidDataException($"Updater-owned cleanup encountered a reparse point: {child}");
+                if ((attributes & FileAttributes.Directory) != 0)
+                {
+                    pending.Push(child);
+                    continue;
+                }
+                File.Delete(child);
+            }
+        }
+
+        for (var index = directories.Count - 1; index >= 0; index--)
+            Directory.Delete(directories[index], recursive: false);
+    }
+}
