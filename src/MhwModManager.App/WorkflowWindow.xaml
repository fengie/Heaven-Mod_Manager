<Window x:Class="MhwModManager.App.WorkflowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Advanced Tools &amp; Diagnostics" Width="1180" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="Your setup, explained" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Inspect file decisions, compare saved setups, and manage advanced compatibility rules." Style="{StaticResource PageSubtitle}"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" Text="Loading…"/>
  <TabControl x:Name="Tabs">
   <TabItem Header="File Decisions">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClick"/><TextBox x:Name="PathFilter" ToolTip="Search by game file or mod name" TextChanged="FilterChanged"/></DockPanel>
     <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TreeView Background="{StaticResource Panel}" Foreground="{StaticResource Text}" x:Name="Folders" SelectedItemChanged="FolderSelected" Margin="0,0,10,0"/><DataGrid x:Name="Files" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FileSelected" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridTextColumn Header="Game file" Binding="{Binding Path, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Mod being used" Binding="{Binding WinnerName, Mode=OneWay}" Width="240"/><DataGridCheckBoxColumn Header="Needs choice" Binding="{Binding Blocking, Mode=OneWay}"/></DataGrid.Columns>
     </DataGrid></Grid>
     <TextBox x:Name="Explanation" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </TabItem>
   <TabItem Header="Portable Mod List">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel><Button Content="Open Mod List…" Click="OpenRecipe"/><Button Content="Export Current Mod List…" Click="ExportRecipe"/><Button Content="Open Vortex Handoff…" Click="OpenVortexHandoff"/><Button Content="Export Vortex Handoff…" Click="ExportVortexHandoff"/><TextBox x:Name="RecipeName" Width="210" Text="Imported setup" ToolTip="New profile name"/><Button Content="Save as Profile" Click="ImportRecipe"/><Button Content="Save Vortex as Profile" Click="ImportVortexHandoff"/><Button Content="Restore Mod Relationships" Click="RestoreRecipeFamilies"/></WrapPanel>
     <DataGrid x:Name="RecipeRows" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,12"><DataGrid.Columns><DataGridTextColumn Header="Mod" Binding="{Binding Entry.DisplayName, Mode=OneWay}" Width="220"/><DataGridTextColumn Header="Status" Binding="{Binding Kind, Mode=OneWay}" Width="170"/><DataGridTextColumn Header="Evidence / next step" Binding="{Binding Detail, Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="Portable lists and Vortex handoffs contain references and file fingerprints, not mod files. Download missing mods from their original authors. Saving creates a profile but does not change live game files until you choose and apply it. Vortex handoff never reads Vortex credentials or deployment state. Restoring relationships only groups known packages and never overwrites existing local rules."/>
    </Grid>
   </TabItem>
   <TabItem Header="Profiles &amp; Compare">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><TextBox x:Name="ProfileName" Width="200" Text="New setup"/><ComboBox x:Name="ParentProfile" Width="220" DisplayMemberPath="Name" ToolTip="Optional parent"/><Button Content="No parent" Click="ClearParent"/><Button Content="Save Pending Setup" Click="SaveProfile"/></WrapPanel>
     <WrapPanel Grid.Row="1" Margin="0,12"><ComboBox x:Name="ProfileA" Width="220" DisplayMemberPath="Name"/><TextBlock Text=" → " VerticalAlignment="Center"/><ComboBox x:Name="ProfileB" Width="220" DisplayMemberPath="Name"/><Button Content="Compare" Click="CompareProfiles"/><Button Content="Use Right Profile" Click="StageProfile"/></WrapPanel>
     <TextBox x:Name="ProfileDiff" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </TabItem>
   <TabItem Header="Compatibility Rules">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><ComboBox x:Name="RuleKindBox" Width="190" SelectedIndex="0"><ComboBoxItem Content="Can load together (overlay)"/><ComboBoxItem Content="Incompatible"/><ComboBoxItem Content="Choose winner for one file"/><ComboBoxItem Content="Choose mod for shared resource"/><ComboBoxItem Content="Main mod + add-on"/><ComboBoxItem Content="Load-order relationship"/></ComboBox><ComboBox x:Name="LeftMod" Width="260" DisplayMemberPath="DisplayName" ToolTip="First mod"/><ComboBox x:Name="RightMod" Width="260" DisplayMemberPath="DisplayName" ToolTip="Second mod or preferred winner"/></WrapPanel>
     <TextBox x:Name="RulePath" Grid.Row="1" Margin="0,8" ToolTip="Exact path, shared resource namespace, or family name"/>
     <WrapPanel Grid.Row="2"><TextBox x:Name="RuleReason" Width="370" Text="User compatibility decision"/><Button Content="Start New Rule" Click="NewRule"/><Button Content="Save rule" Click="SaveRule"/><Button Content="Delete selected rule" Click="DeleteRule"/><Button Content="Clear Saved Winner" Click="ClearProvider"/></WrapPanel>
     <DataGrid x:Name="RuleRows" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,12" SelectionChanged="RuleSelected"><DataGrid.Columns><DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope, Mode=OneWay}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Path" Binding="{Binding PathPattern, Mode=OneWay}" Width="240"/></DataGrid.Columns></DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Relationships">
    <DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="GraphMod" Width="300" DisplayMemberPath="DisplayName"/><Button Content="Show Related Mods" Click="GraphClick"/><TextBlock Text="Gold: one mod takes priority · Red: incompatible · Blue: related packages" VerticalAlignment="Center" Margin="12"/></WrapPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="GraphCanvas" Width="1000" Height="800"/></ScrollViewer></DockPanel>
   </TabItem>
   <TabItem Header="Safe Update">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><ComboBox x:Name="OldMod" Width="260" DisplayMemberPath="DisplayName"/><TextBlock Text=" → " VerticalAlignment="Center"/><ComboBox x:Name="NewMod" Width="260" DisplayMemberPath="DisplayName"/><Button Content="Preview Update" Click="PreviewUpgrade"/><Button x:Name="UpgradeButton" Content="Apply Update" Click="Upgrade" IsEnabled="False"/></WrapPanel>
     <TextBox x:Name="UpdateDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12"/>
    </Grid>
   </TabItem>
   <TabItem Header="Launch History">
    <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap" Text="Observed launches are evidence, not a quality score. Startup failure associations do not prove that a mod caused the failure. No record means untested."/><DataGrid x:Name="TrustRows" IsReadOnly="True" AutoGenerateColumns="True"/></DockPanel>
   </TabItem>
   <TabItem Header="Technical Game Details">
    <TextBox x:Name="AdapterDetails" Margin="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
