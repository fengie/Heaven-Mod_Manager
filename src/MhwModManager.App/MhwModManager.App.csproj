    <Content Include="../../THIRD_PARTY_NOTICES.md"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory><Link>THIRD_PARTY_NOTICES.md</Link></Content>
