+        return manifest;
+    }
+
+    public static void ValidateManifest(UpdateManifest manifest)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        ArgumentNullException.ThrowIfNull(manifest);
+        if (manifest.SchemaVersion != UpdateConstants.ManifestSchemaVersion)
+            throw new InvalidDataException($"Unsupported update manifest schema {manifest.SchemaVersion}.");
+        if (manifest.MinimumUpdaterSchemaVersion > UpdateConstants.ManifestSchemaVersion)
+            throw new InvalidDataException("This update requires a newer updater bootstrap.");
+        if (!manifest.Channel.Equals(UpdateConstants.Channel, StringComparison.Ordinal))
+            throw new InvalidDataException($"Unexpected update channel: {manifest.Channel}");
+        if (!manifest.Repository.Equals(UpdateConstants.Repository, StringComparison.Ordinal))
+            throw new InvalidDataException($"Unexpected update repository: {manifest.Repository}");
+        if (string.IsNullOrWhiteSpace(manifest.ProductVersion))
+            throw new InvalidDataException("Update manifest product version is missing.");
+        RequireSha(manifest.SourceSha, "source SHA", 40);
+        if (manifest.BuildNumber <= 0) throw new InvalidDataException("Update build number must be positive.");
+        if (manifest.RunId <= 0) throw new InvalidDataException("Update run ID must be positive.");
+        if (manifest.Size <= 0 || manifest.Size > UpdateConstants.MaxArtifactBytes)
+            throw new InvalidDataException("Update artifact size is outside the supported budget.");
+        RequireSha(manifest.Sha256, "artifact SHA-256", 64);
+        RequireSha(manifest.PayloadManifestSha256, "payload manifest SHA-256", 64);
+        if (Path.GetFileName(manifest.Artifact) != manifest.Artifact ||
+            !manifest.Artifact.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
+            throw new InvalidDataException("Update artifact name is unsafe.");
+        var expectedTag = BuildReleaseTag(manifest.BuildNumber, manifest.SourceSha);
+        if (!manifest.ReleaseTag.Equals(expectedTag, StringComparison.Ordinal))
+            throw new InvalidDataException("Update release tag does not match build identity.");
+        if (manifest.CreatedUtc == default || manifest.PublishedUtc == default)
+            throw new InvalidDataException("Update timestamps are missing.");
+    }
