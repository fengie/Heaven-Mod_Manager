+using System.Reflection;
+using MhwModManager.Core;
+
+namespace MhwModManager.Updater;
+
+public static class BuildIdentityReader
+{
+    public static BuildIdentity FromAssembly(Assembly assembly)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        ArgumentNullException.ThrowIfNull(assembly);
+        var metadata = assembly.GetCustomAttributes<AssemblyMetadataAttribute>()
+            .GroupBy(static x => x.Key, StringComparer.Ordinal)
+            .ToDictionary(static g => g.Key, static g => g.Last().Value ?? string.Empty, StringComparer.Ordinal);
+
+        var version = Get(metadata, "MhwProductVersion");
+        if (string.IsNullOrWhiteSpace(version))
+            version = assembly.GetName().Version?.ToString(3) ?? "0.0.0";
+
+        var source = Get(metadata, "MhwSourceSha");
+        if (string.IsNullOrWhiteSpace(source)) source = "local";
+
+        var build = ParseLong(Get(metadata, "MhwBuildNumber"));
+        var runId = ParseLong(Get(metadata, "MhwRunId"));
+        DateTimeOffset? built = DateTimeOffset.TryParse(Get(metadata, "MhwBuildTimestampUtc"), out var timestamp)
+            ? timestamp
+            : null;
+
+        return new BuildIdentity(version, source, build, runId, built);
+    }
+
+    private static string Get(Dictionary<string, string> metadata, string key)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        return metadata.TryGetValue(key, out var value) ? value : string.Empty;
+    }
+
+    private static long ParseLong(string value)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        return long.TryParse(value, System.Globalization.NumberStyles.None,
+            System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0;
+    }
+}
+
+public static class UpdateOrdering
+{
+    public static bool IsNewer(BuildIdentity current, UpdateManifest remote)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        ArgumentNullException.ThrowIfNull(current);
+        ArgumentNullException.ThrowIfNull(remote);
+        if (remote.BuildNumber <= current.BuildNumber) return false;
+        return true;
+    }
+
+    public static void ValidateNoAmbiguousSameBuild(BuildIdentity current, UpdateManifest remote)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        if (remote.BuildNumber != current.BuildNumber) return;
+        if (StringComparer.OrdinalIgnoreCase.Equals(remote.SourceSha, current.SourceSha)) return;
+        throw new InvalidDataException(
+            $"Update feed build {remote.BuildNumber} conflicts with the current source identity.");
+    }
+}
