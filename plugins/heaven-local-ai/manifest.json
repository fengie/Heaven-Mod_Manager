{
  "schema": "heaven-plugin/manifest/v1",
  "name": "heaven-local-ai",
  "version": "0.1.0",
  "entrypoint": "heaven_local_ai.service:HeavenLocalAiPlugin",
  "capabilities": [
    "local_ai.models",
    "local_ai.generate",
    "local_ai.summarize"
  ],
  "depends_on": {
    "heaven-control-plane": ">=0.4.0",
    "host_binary": "ollama"
  },
  "security": {
    "prompt_shell_interpolation": false,
    "model_name_allowlist_regex": true,
    "max_prompt_characters": 50000
  }
}
