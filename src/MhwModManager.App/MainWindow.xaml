<Window x:Class="MhwModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1480" Height="900" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshAnalysisNowCommand}"/>
    </Window.InputBindings>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- App bar -->
        <Border Grid.Row="0" Background="#0A1018" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentDim}" BorderBrush="#24564F" BorderThickness="1">
                        <TextBlock Text="UM" Foreground="{StaticResource AccentBright}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Universal Mod Manager" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"/>
                            <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="10" Background="#102A29" BorderBrush="#24564F" BorderThickness="1">
                                <TextBlock Text="{Binding CurrentProgramBuildText}" Foreground="{StaticResource AccentBright}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock MaxWidth="360" Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding HeaderSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderSummary}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D151F" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="10,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GAME" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <ComboBox Width="190" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame,Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Active game"/>
                        <Button Content="Switch" Command="{Binding SwitchGameCommand}" Style="{StaticResource QuietButton}" Margin="5,0,0,0" Padding="10,6"/>
                        <Button Content="Settings" Command="{Binding ConfigureGameCommand}" Style="{StaticResource QuietButton}" Margin="2,0,0,0" Padding="10,6"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0"/>
                    <Button Content="Apply Changes" Command="{Binding ApplyCommand}" Margin="0,0,8,0" ToolTip="Safely install your pending mod changes. Ctrl+Enter."/>
                    <Button Content="Launch Game" Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Back up your saves, check the setup, and launch the game with your enabled mods."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sidebar + pages -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    TabStripPlacement="Left"
                    SelectedIndex="{Binding SelectedTab}"
                    SelectionChanged="OnMainTabSelectionChanged">
            <TabItem Header="Dashboard">
                <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1320" HorizontalAlignment="Stretch" Margin="32,30,36,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Your game, your mods, and the next action — without the clutter." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,22,0,14" Style="{StaticResource HeroCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT SETUP" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding SelectedGame.DisplayName}" FontSize="25" FontWeight="Bold"/>
                                    <TextBlock Margin="0,9,0,0" MaxWidth="650" Text="{Binding StatusText}" FontSize="16" TextWrapping="Wrap" LineHeight="23"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                        <Button Content="Launch Game" Command="{Binding LaunchModdedCommand}" Style="{StaticResource PrimaryButton}" Padding="20,11"/>
                                        <Button Content="Apply Pending Changes" Command="{Binding ApplyCommand}" Margin="8,0,0,0" Padding="18,11"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Margin="24,0,0,0" Padding="18" Background="#0B141E" BorderBrush="#27394C" BorderThickness="1" CornerRadius="14">
                                    <StackPanel>
                                        <TextBlock Text="APP &amp; GAME HEALTH" Style="{StaticResource Eyebrow}"/>
                                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource AccentBright}" FontWeight="SemiBold" Text="{Binding ProgramUpdateStatus}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding LatestProgramBuildText}" TextWrapping="Wrap"/>
                                        <Border Margin="0,14,0,0" Height="1" Background="{StaticResource Border}"/>
                                        <TextBlock Margin="0,13,0,0" Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding GamePathText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="2" Columns="4" Margin="-5,0,-5,14">
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding EnabledCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                                    <TextBlock Text="Active mods" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="enabled in this setup" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FullyEffectiveCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Info}"/>
                                    <TextBlock Text="Working in game" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding ComposedCount,Mode=OneWay}"/><Run Text=" partly replaced"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BlockerCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                                    <TextBlock Text="Needs attention" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="choices before apply" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="5" Style="{StaticResource MetricCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StagedCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBright}"/>
                                    <TextBlock Text="Pending changes" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,3,0,0" Text="ready to apply" Foreground="{StaticResource Muted}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Margin="0,0,7,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Setup details" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Everything important about the current installation." Style="{StaticResource PageSubtitle}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeGood}">
                                            <TextBlock Text="CURRENT" Foreground="{StaticResource Good}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Border Margin="0,16,0,0" Padding="14" Background="#0B141E" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                                        <TextBlock Text="{Binding UnmanagedAdoptionLabel}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Margin="0,0,5,0" Style="{StaticResource ActionTile}" Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}"/>
                                        <Button Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource ActionTile}" Content="Launch Without Mods" Command="{Binding LaunchSafeModeCommand}"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Margin="0,0,5,0" Style="{StaticResource ActionTile}" Content="Restore Last Working Setup" Command="{Binding RestoreLastGoodCommand}"/>
                                        <Button Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource ActionTile}" Content="Review Shared Files" Command="{Binding ShowOverlapsCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Margin="7,0,0,0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Common things you may want to do next." Style="{StaticResource PageSubtitle}"/>
                                    <Button Margin="0,16,0,8" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left" Content="Install a Mod" Command="{Binding ImportArchiveCommand}"/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Find Installed Games" Command="{Binding ScanInstalledGamesCommand}"/>
                                    <Button Margin="0,0,0,8" Style="{StaticResource ActionTile}" Content="Game Settings" Command="{Binding ConfigureGameCommand}"/>
                                    <Expander Header="More tools" Margin="4,10,4,0" Foreground="{StaticResource Text}">
                                        <StackPanel Margin="0,10,0,0">
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Install Mods from Inbox" Command="{Binding ProcessInboxCommand}"/>
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Find Mod Causing Startup Crash" Command="{Binding AutoDiagnoseCrashCommand}"/>
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Clean Up Duplicate Mods" Command="{Binding SmartCleanupCommand}"/>
                                            <Button Margin="0,0,0,7" HorizontalContentAlignment="Left" Content="Export Mod List" Command="{Binding ExportRecipeCommand}"/>
                                            <Button Margin="0" HorizontalContentAlignment="Left" Content="Advanced Tools &amp; Diagnostics" Command="{Binding OpenWorkflowsCommand}"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Mods">
                <Grid HorizontalAlignment="Stretch">
                <Grid Margin="8,6,8,6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mods" Style="{StaticResource PageTitle}"/>
                            <Border Margin="10,0,0,0" Style="{StaticResource StatusBadge}" VerticalAlignment="Center">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Text="{Binding InstalledCountLabel,Mode=OneWay}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="14,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12"
                                   Text="Stage what you want active, inspect the result, then apply once."
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="Stage what you want active, inspect the result, then apply once."/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Content="Check Mod Info" Command="{Binding SyncMetadataCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Refresh mod names, artwork, known relationships, and update availability."/>
                            <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Copy unmanaged files from this game profile's configured mod folder into a tracked source package without modifying the live tree."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,6,0,6" Style="{StaticResource SubtleCard}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="SEARCH MODS" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="Ctrl+F"/>
                                </StackPanel>
                                <TextBox x:Name="ModSearchBox" Grid.Column="1" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search mods" ToolTip="Search mod name, add-on, category, source, or problem. Ctrl+F jumps here."/>
                                <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource StatusBadge}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"><Run Text="{Binding VisibleModCount,Mode=OneWay}"/><Run Text=" shown · "/></TextBlock>
                                        <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="All mods"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Enabled"><Setter Property="Text" Value="Enabled"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Staged"><Setter Property="Text" Value="Pending changes"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Updates"><Setter Property="Text" Value="Updates"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Issues"><Setter Property="Text" Value="Problems"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Revalidate"><Setter Property="Text" Value="Needs check"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding ModViewMode}" Value="Superseded"><Setter Property="Text" Value="Not currently used"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ScrollViewer x:Name="ModLibraryToolbar"
                                          Grid.Row="1"
                                          Margin="0,6,0,0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="FILTERS" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding AllViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="All" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show every mod in this library."/>
                                        <Button Content="{Binding EnabledViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Enabled" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show mods that are enabled in the pending setup."/>
                                        <Button Content="{Binding StagedViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Staged" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show only unapplied changes."/>
                                        <Button Content="{Binding UpdatesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Updates" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show mods with detected Nexus updates."/>
                                        <Button Content="{Binding IssuesViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Issues" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show mods with saved crash or graphics-problem evidence."/>
                                        <Button Content="{Binding RevalidateViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Revalidate" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show mods that should be checked again after a game update."/>
                                        <Button Content="{Binding SupersededViewLabel}" Command="{Binding SetModViewCommand}" CommandParameter="Superseded" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Show enabled mods whose files are completely replaced by other enabled mods."/>
                                    </StackPanel>
                                    <Border Width="1" Height="24" Margin="10,0" Background="{StaticResource Border}"/>
                                    <TextBlock Text="AUTO SETUP" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Auto Populate" Command="{Binding AutoPopulateCommand}" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="11,5" Margin="2,0" ToolTip="Automatically enable and apply the largest safe set of installed mods. Required dependencies and texture providers are included only when the complete setup stays conflict-free."/>
                                    <Border Width="1" Height="24" Margin="10,0" Background="{StaticResource Border}"/>
                                    <TextBlock Text="BULK · VISIBLE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Enable Visible Mods" Command="{Binding EnableSelectedCommand}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Turn on every mod currently shown by the search and filters."/>
                                        <Button Content="Disable Visible Mods" Command="{Binding DisableSelectedCommand}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Turn off every mod currently shown by the search and filters."/>
                                        <Button Content="Refresh Mod Info" Command="{Binding ReindexSelectedCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Re-read the files and information for every mod currently shown."/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid x:Name="ModLibraryRegion" Grid.Row="2">
                        <Border CornerRadius="9" ClipToBounds="True" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding ModsView}" SelectedItem="{Binding SelectedMod,Mode=TwoWay}" SelectionMode="Extended" AutoGenerateColumns="False" IsReadOnly="False" RowDetailsVisibilityMode="VisibleWhenSelected" RowHeight="58" AutomationProperties.Name="Mod library">
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Margin="72,2,18,10" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Mod preview" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Cached Nexus artwork and screenshots found inside the source packages. Select a mod to load its gallery."/>
                                            <ItemsControl ItemsSource="{Binding GalleryPaths}" Margin="0,0,0,14">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="156" Height="102" Margin="0,0,8,8" CornerRadius="6" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                            <Image Source="{Binding Converter={StaticResource SafeImage},ConverterParameter=320}" Stretch="UniformToFill" ToolTip="{Binding}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Advanced mod options" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" FontSize="11" Text="The main toggle controls the whole mod. Open these options only when you want to turn individual add-ons or components on or off."/>
                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="2" Padding="7,2" CornerRadius="9" BorderBrush="#303844" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="{Binding Role}" FontSize="10" Foreground="{StaticResource AccentBright}"/></Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding NexusLabel}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="ENABLED" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding StagedEnabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsThreeState="False" HorizontalAlignment="Center" ToolTip="Turn the whole mod on or off. A partial state means only some add-ons or components are enabled."/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="76" Height="48" CornerRadius="5" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="IMG" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ThumbnailPath,Converter={StaticResource SafeImage},ConverterParameter=160}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MOD" Width="2.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding IdentityHint}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}"/>
                                                <TextBlock Text="{Binding IssueBadge}" Foreground="{StaticResource Warn}" FontSize="10" FontWeight="SemiBold" ToolTip="{Binding IssueReason}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasIssue}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding UpdateBadge}" Foreground="{StaticResource Good}" FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="132">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusBadge}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLabel}" Value="Enabled">
                                                                <Setter Property="Background" Value="#13241C"/>
                                                                <Setter Property="BorderBrush" Value="#28553E"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasStagedChanges}" Value="True">
                                                                <Setter Property="Background" Value="#272113"/>
                                                                <Setter Property="BorderBrush" Value="#5B4720"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateLabel}" Value="Enabled"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding HasStagedChanges}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBright}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="IN GAME" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding EffectiveReason}">
                                                <TextBlock Text="{Binding EffectLabel}" FontWeight="SemiBold"/>
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10"><Run Text="{Binding WinningFiles,Mode=OneWay}"/><Run Text=" winning • "/><Run Text="{Binding ShadowedFiles,Mode=OneWay}"/><Run Text=" shadowed"/></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="125" IsReadOnly="True"/>
                                <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="76" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="INSTALLED FROM" Width="1.2*" SortMemberPath="SourceSummary">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceSummary}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Margin="16,8">
                                <TextBlock Text="Your mod library is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Install a downloaded mod archive, or bring existing manual mod files into the manager."/>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Install Mod" Command="{Binding ImportArchiveCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Choose a downloaded mod archive and add it to this game's library."/>
                                    <Button Content="Bring In Manual Mods" Command="{Binding AdoptManualFilesCommand}" ToolTip="Copy unmanaged files from the configured mod folder into a tracked source package without modifying the live tree."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#E60A0D11" CornerRadius="9" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" IsHitTestVisible="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleModCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding InstalledCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="16,8">
                                <TextBlock Text="No mods match this view" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="Your mods are still here. Clear the search and filters to show everything again."/>
                                <Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="Clear filters" Command="{Binding ClearModFiltersCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource SubtleCard}" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource Text}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="{Binding StagedSummary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PlanPreviewText}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Preview Mod Changes" Command="{Binding PreviewApplyCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="See exactly what would change without editing game files."/>
                                <Button Content="Discard Pending Changes" Command="{Binding DiscardStagedCommand}" Style="{StaticResource QuietButton}" MinHeight="32" Padding="9,5" Margin="2,0" ToolTip="Discard all pending enable/disable changes. Installed game files are not changed."/>
                                <Button Content="Apply Mod Changes" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="10,5" Margin="2,0" ToolTip="Safely install your pending mod changes. Ctrl+Enter."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding CoverageTabLabel}">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CoverageTitle}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding CoverageSubtitle}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh coverage" Command="{Binding RefreshOutfitsCommand}" VerticalAlignment="Bottom"/>
                    </Grid>
                    <DataGrid Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding OutfitRows}" SelectedItem="{Binding SelectedOutfit,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="88" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Margin="126,4,18,12" Padding="14" Background="#0D1217" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="250" Height="160" CornerRadius="7" Background="#090D12" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left">
                                            <Grid>
                                                <TextBlock Text="No visual available" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=512}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,2,0,0">
                                            <TextBlock Text="{Binding Armor}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Foreground="{StaticResource Muted}" Text="{Binding ModelId}"/>
                                            <TextBlock Text="Supplying mods" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,10" Text="{Binding Providers}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="Winning pieces" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding WinningPieces}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="LOOK" Width="126">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="108" Height="72" CornerRadius="6" Background="#0B1016" BorderBrush="{StaticResource Border}" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="No preview" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=224}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ARMOR" Binding="{Binding Armor}" Width="1.8*"/>
                            <DataGridTextColumn Header="MODEL" Binding="{Binding ModelId}" Width="110"/>
                            <DataGridTextColumn Header="OPTIONS" Binding="{Binding Available}" Width="90"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="USED PIECES" Binding="{Binding WinningPieces}" Width="1.4*"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Needs attention">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Needs attention" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#2B2114" BorderBrush="#59401F" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource Warn}" FontSize="11" FontWeight="Bold"><Run Text="{Binding BlockerCount,Mode=OneWay}"/><Run Text=" conflicts • "/><Run Text="{Binding IssueCount,Mode=OneWay}"/><Run Text=" problem clues"/></TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Review mod conflicts and clues from recent crashes. Problem marks never disable or delete a mod; they only help you narrow down what to check." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Report game crash" Command="{Binding ReportGameCrashCommand}" ToolTip="Record that the game crashed so the manager can compare recently changed mods with the last successful launch."/>
                            <Button Content="Report GPU/graphics crash" Command="{Binding ReportGpuGraphicsCrashCommand}" Style="{StaticResource AttentionButton}" ToolTip="Record a graphics-related crash so recently changed graphics and texture mods can be checked first."/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Suspected problem mods" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,8" Foreground="{StaticResource Muted}" FontSize="11" Text="Added after a failed startup or a crash you report. Stronger evidence means a mod is worth checking first, but it does not prove the mod caused the crash." TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding IssueSuspects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,3" Padding="9" Background="#11161C" BorderBrush="#413520" BorderThickness="1" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Kind}" Foreground="{StaticResource Warn}" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ConfidenceLabel}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FailureLabel}"/><TextBlock Text="{Binding LastSeen}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#D0D5DB" FontSize="10" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Grid.Column="4" Content="Clear mark" Command="{Binding DataContext.ClearIssueSuspectCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding ModId}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" ToolTip="Remove this problem clue. The mod and game files are not changed."/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Good}" FontSize="11" Text="No mods are currently flagged for investigation.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IssueCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,14">
                    <DataGrid ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Unresolved conflicts">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISSUE" Binding="{Binding Kind}" Width="145"/>
                            <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="2*"/>
                            <DataGridTextColumn Header="FILES" Binding="{Binding FileCountLabel}" Width="70"/>
                            <DataGridTextColumn Header="AFFECTED CONTENT" Binding="{Binding Scope}" Width="2.2*"/>
                            <DataGridTextColumn Header="WHAT'S HAPPENING" Binding="{Binding Explanation}" Width="3*"/>
                            <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding ConfidenceLabel}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding BlockerCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No unresolved conflict choices" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The pending setup has no mod conflicts that need your choice."/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Border Grid.Row="3" Padding="14">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedConflict}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Choose which mod should win" FontWeight="SemiBold"/>
                            <TextBlock Text="Use a single winner when these mods are alternatives. If one is the main mod and the others are add-ons, tell the manager that relationship instead so they can work together." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <Expander Header="Technical details" Margin="0,0,0,10" Foreground="{StaticResource Muted}">
                                <TextBlock Margin="0,8,0,0" Text="{Binding SelectedConflict.Evidence}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                            </Expander>
                            <ItemsControl ItemsSource="{Binding SelectedConflict.Options}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Padding="10" MinWidth="190" MaxWidth="230" Style="{StaticResource Card}">
                                            <StackPanel>
                                                <Border Width="170" Height="82" Background="#0B0F13" CornerRadius="6" Margin="0,0,0,7" ClipToBounds="True">
                                                    <Image Source="{Binding PreviewPath,Converter={StaticResource SafeImage},ConverterParameter=384}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="205"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#D0D5DB" TextWrapping="Wrap" MaxWidth="205" Margin="0,3,0,8"/>
                                                <Button Content="Use This Mod" Margin="0,0,0,6" Command="{Binding DataContext.ChooseConflictOptionCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" Style="{StaticResource PrimaryButton}"/>
                                                <Button Content="Treat as Main Mod + Add-ons" Command="{Binding DataContext.ChainConflictFamilyCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Token}" ToolTip="Remember that this is the main mod and the other packages are add-ons that belong with it."/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Profiles">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Save a complete mod setup and switch back to it later without rebuilding it by hand." Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,20,0,12" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProfileName}" AutomationProperties.Name="New profile name" ToolTip="Name for the mod setup you are about to save."/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="Save Current Setup" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Use Selected Profile" Command="{Binding StageProfileCommand}"/>
                                <Button Content="Refresh" Command="{Binding RefreshProfilesCommand}" Style="{StaticResource QuietButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Saved profiles">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PROFILE" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="ENABLED MODS" Binding="{Binding EnabledMods}" Width="140"/>
                                <DataGridTextColumn Header="UPDATED" Binding="{Binding UpdatedAt}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Profiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No saved profiles yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Name your current mod setup above, then choose Save Current Setup."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="History">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="History &amp; support" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="See what the manager changed and create diagnostics only when you need support." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Refresh" Command="{Binding RefreshActivityCommand}" Style="{StaticResource QuietButton}"/>
                            <Button Content="Collect Diagnostics" Command="{Binding CaptureDiagnosticsCommand}"/>
                            <Button Content="Create Support Bundle" Command="{Binding ExportSupportCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,10">
                        <DataGrid ItemsSource="{Binding ActivityRows}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Recent activity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="WHEN" Binding="{Binding Started}" Width="190"/>
                                <DataGridTextColumn Header="STATUS" Binding="{Binding State}" Width="120"/>
                                <DataGridTextColumn Header="ACTION" Binding="{Binding Description}" Width="2.5*"/>
                                <DataGridTextColumn Header="SUPPORT ID" Binding="{Binding Id}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding ActivityRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No activity recorded yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="Applied changes, restores, and support actions will appear here."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Text="Support bundles contain logs and troubleshooting details, not your mod files or large game files."/>
                </Grid>
            </TabItem>

            <TabItem Header="Shared Files">
                <Grid Margin="28,26,32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Shared files" Style="{StaticResource PageTitle}"/>
                                <Border Margin="12,5,0,0" Padding="8,3" CornerRadius="11" Background="#151A20" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="{Binding OverlapCount,Mode=OneWay}"/>
                                        <TextBlock Margin="4,0,0,0" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Text="shared assets"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="See when more than one mod changes the same game file. The manager handles safe cases automatically and explains the result when you want details." Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Why This Mod Wins" Command="{Binding ExplainSelectedOverlapCommand}" ToolTip="Explain which mod supplies this shared file and why. Technical evidence is included below."/>
                            <Button Content="Refresh analysis" Command="{Binding RefreshAnalysisNowCommand}" ToolTip="F5"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,12" Style="{StaticResource Card}" Padding="12">
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Sharing a file is not always a problem. Select a row to see which mod is being used and why; unresolved choices appear in Needs Attention instead of being guessed."/>
                    </Border>

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding OverlapRows}" SelectedItem="{Binding SelectedOverlap,Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Asset overlaps">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GAME FILE" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding ProviderCount}" Width="90"/>
                                <DataGridTextColumn Header="RESULT" Binding="{Binding Resolution}" Width="140"/>
                                <DataGridTextColumn Header="MODS" Binding="{Binding Providers}" Width="3*"/>
                                <DataGridTextColumn Header="DETAILS" Binding="{Binding Detail}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStatePanel}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding OverlapCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="No shared files detected" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Muted}" Text="The enabled mods in this setup are not competing for the same files."/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Why this file uses this mod" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" Text="{Binding ExplainWhyStatus}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Padding="8,3" CornerRadius="11" BorderBrush="#303844" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedExplanation.RuleSource}"/>
                                </Border>
                            </Grid>

                            <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Summary}"/>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="FILE PATH"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedExplanation.Path}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="TECHNICAL REASON"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.ReasonCode}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="CONFIDENCE"/>
                                    <TextBlock Margin="0,3,12,0" Text="{Binding SelectedExplanation.Confidence}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="AUTOMATION SCORE"/>
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedExplanation.ResolverScore}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="10" Text="EXPLANATION"/>
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Explanation}"/>
                                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="10" Text="EVIDENCE"/>
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="{Binding SelectedExplanation.Evidence}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="4" Margin="0,12,0,0" MaxHeight="150" ItemsSource="{Binding SelectedExplanation.Providers}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MOD" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridCheckBoxColumn Header="WILL USE" Binding="{Binding PlannedWinner}" Width="82"/>
                                    <DataGridCheckBoxColumn Header="IN USE" Binding="{Binding AppliedProvider}" Width="82"/>
                                    <DataGridTextColumn Header="LOAD ORDER" Binding="{Binding Priority}" Width="72"/>
                                    <DataGridTextColumn Header="FAMILY" Binding="{Binding FamilyId}" Width="1.4*"/>
                                    <DataGridTextColumn Header="ROLE" Binding="{Binding FamilyRole}" Width="100"/>
                                    <DataGridTextColumn Header="NEXUS MOD" Binding="{Binding NexusModId}" Width="100"/>
                                    <DataGridTextColumn Header="SOURCE" Binding="{Binding ProvenanceSource}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#090C10" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Good}" Margin="0,0,8,0"/>
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Text="{Binding FooterText}"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Width="170" Height="4" IsIndeterminate="True" Visibility="{Binding BusyVisibility}"/>
            </Grid>
        </Border>

        <!-- Blocking operation overlay -->
        <Border x:Name="BusyOverlay"
                Grid.RowSpan="3"
                Background="#C30A0D11"
                Visibility="{Binding BusyVisibility}"
                IsVisibleChanged="OnBusyOverlayIsVisibleChanged"
                Panel.ZIndex="50">
            <Border x:Name="BusyDialogCard"
                    Width="470"
                    Padding="28"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentDim}" HorizontalAlignment="Left">
                        <TextBlock Text="…" Foreground="{StaticResource AccentBright}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Margin="0,16,0,0" FontSize="21" FontWeight="SemiBold" Text="{Binding BusyTitle}"/>
                    <TextBlock Margin="0,8,0,18" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19" Text="{Binding BusyDetail}"/>
                    <ProgressBar IsIndeterminate="True" Height="5"/>
                    <Button Margin="0,18,0,0" HorizontalAlignment="Right" Content="Cancel" Command="{Binding CancelBusyCommand}" Visibility="{Binding CancelVisibility}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
