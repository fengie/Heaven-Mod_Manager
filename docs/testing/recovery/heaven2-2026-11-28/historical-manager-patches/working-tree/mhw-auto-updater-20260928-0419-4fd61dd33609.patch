+public static class UpdateBootstrap
+{
+    public static async Task<bool> TryLaunchPendingHelperAtStartupAsync(
+        Assembly appAssembly,
+        IReadOnlyList<string> currentArguments,
+        CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var installRoot = Path.GetFullPath(AppContext.BaseDirectory)
+            .TrimEnd(Path.DirectorySeparatorChar);
+        var paths = UpdateStatePaths.ForInstallRoot(installRoot);
+        var state = new UpdateStateStore(paths);
+        var pending = await state.LoadPendingAsync(ct).ConfigureAwait(false);
+        if (pending is null) return false;
+        var current = BuildIdentityReader.FromAssembly(appAssembly);
+        var journal = await state.LoadJournalAsync(ct).ConfigureAwait(false);
+
+        if (journal is not null && journal.UpdateId.Equals(pending.UpdateId, StringComparison.Ordinal))
+        {
+            if (journal.Phase == UpdateApplyPhase.Committed)
+            {
+                state.ClearPending();
+                return false;
+            }
+            if (journal.Phase == UpdateApplyPhase.RolledBack)
+            {
+                state.ClearPending();
+                return false;
+            }
+            if (journal.Phase == UpdateApplyPhase.AppliedAwaitingHealth &&
+                current.BuildNumber == pending.Manifest.BuildNumber &&
+                current.SourceSha.Equals(pending.Manifest.SourceSha, StringComparison.OrdinalIgnoreCase))
+            {
+                return false;
+            }
+        }
+
+        var packages = new UpdatePackageService(state);
+        try
+        {
+            await packages.VerifyStagedAsync(pending, ct).ConfigureAwait(false);
+        }
+        catch (Exception ex) when (ex is IOException or InvalidDataException or UnauthorizedAccessException)
+        {
+            MasterDebugLog.Write("UPDATER",
+                "Pending update failed startup re-verification; current application will continue.", ex);
+            return false;
+        }
+
+        pending = new PendingUpdateState
+        {
+            SchemaVersion = pending.SchemaVersion,
+            UpdateId = pending.UpdateId,
+            InstallRoot = pending.InstallRoot,
+            StagingRoot = pending.StagingRoot,
+            ArchivePath = pending.ArchivePath,
+            Manifest = pending.Manifest,
+            Payload = pending.Payload,
+            RestartExecutable = pending.RestartExecutable,
+            RestartArguments = UpdateCommandLine.FilterUserArguments(currentArguments),
+            StagedUtc = pending.StagedUtc
+        };
+        await state.SavePendingAsync(pending, ct).ConfigureAwait(false);
+        var start = UpdateCommandLine.BuildHelperStartInfo(pending, Environment.ProcessId);
+        ProcessDebug.Start(start, "startup pending-update helper");
+        return true;
+    }
+}
