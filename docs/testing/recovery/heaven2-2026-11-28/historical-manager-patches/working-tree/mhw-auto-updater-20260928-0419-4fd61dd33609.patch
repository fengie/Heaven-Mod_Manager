+
+public sealed record BuildIdentity(
+    string ProductVersion,
+    string SourceSha,
+    long BuildNumber,
+    long RunId,
+    DateTimeOffset? BuiltUtc)
+{
+    public bool IsPublishedBuild =>
+        BuildNumber > 0 &&
+        SourceSha.Length == 40 &&
+        SourceSha.All(static c => Uri.IsHexDigit(c));
+
+    public string ShortSourceSha => SourceSha.Length >= 12 ? SourceSha[..12] : SourceSha;
+    public string Display => $"v{ProductVersion} · build {BuildNumber} · {ShortSourceSha}";
+}
+
+public sealed class UpdateManifest
+{
