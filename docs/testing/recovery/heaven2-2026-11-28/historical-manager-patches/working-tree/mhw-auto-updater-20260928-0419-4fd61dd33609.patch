+}
+
+public sealed class ProductPayloadManifest
+{
+    public int SchemaVersion { get; init; }
+    public string ProductId { get; init; } = string.Empty;
+    public string Channel { get; init; } = string.Empty;
+    public string ProductVersion { get; init; } = string.Empty;
+    public string SourceSha { get; init; } = string.Empty;
+    public long BuildNumber { get; init; }
+    public string Executable { get; init; } = string.Empty;
+    public IReadOnlyList<ProductFileEntry> Files { get; init; } = [];
+}
+
+public sealed record ProductFileEntry(string Path, long Size, string Sha256);
+
+public sealed class ManagedInstallMarker
+{
+    public int SchemaVersion { get; init; } = 1;
+    public string ProductId { get; init; } = UpdateConstants.ProductId;
+    public string Channel { get; init; } = UpdateConstants.Channel;
+    public string ProductVersion { get; init; } = string.Empty;
+    public string SourceSha { get; init; } = string.Empty;
+    public long BuildNumber { get; init; }
+    public string InstallMode { get; init; } = "managed-portable";
+}
+
+public enum UpdateStatusKind
+{
+    Idle,
+    Checking,
+    AuthenticationRequired,
+    Disabled,
+    Current,
+    UpdateAvailable,
+    Downloading,
+    Staging,
+    Staged,
+    Applying,
+    Error
+}
+
+public sealed record UpdateSnapshot(
+    UpdateStatusKind Status,
+    string Message,
+    BuildIdentity Current,
+    BuildIdentity? Latest = null,
+    string? PendingUpdateId = null);
+
+public sealed class UpdateCandidate
+{
+    public required UpdateManifest Manifest { get; init; }
