{
  "schema":"heaven-plugin/manifest/v1",
  "name":"heaven-git-ops",
  "version":"0.1.0",
  "entrypoint":"heaven_git_ops.service:GitOpsPlugin",
  "capabilities":[
    "git.log","git.show","git.branches","git.fetch","git.pull_ff",
    "git.add","git.commit","git.push","git.branch.delete","git.integrate_task_to_main"
  ],
  "depends_on":{"heaven-control-plane":">=0.4.0"},
  "security":{
    "push_requires_confirmation":true,
    "branch_delete_requires_ancestor_of_origin_main":true,
    "canonical_branch_delete_blocked":true
  }
}
