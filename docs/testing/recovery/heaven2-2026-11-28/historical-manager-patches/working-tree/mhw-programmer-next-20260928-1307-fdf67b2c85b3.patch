+    private sealed class ScriptedArchiveOutputBackend(
+        Func<Stream,ReadOnlyMemory<byte>,CancellationToken,ValueTask>? write=null,
+        Action<string>? delete=null) : IArchiveOutputBackend
+    {
+        public int DeleteAttempts { get; private set; }
+
+        public Stream CreateOutput(string path) => new FileStream(
+            path,
+            FileMode.CreateNew,
+            FileAccess.Write,
+            FileShare.None,
+            128*1024,
+            FileOptions.Asynchronous|FileOptions.SequentialScan);
+
+        public async ValueTask WriteAsync(Stream output,ReadOnlyMemory<byte> buffer,CancellationToken ct)
+        {
+            if(write is not null)await write(output,buffer,ct);
+            else await output.WriteAsync(buffer,ct);
+        }
+
+        public void DeleteOutput(string path)
+        {
+            DeleteAttempts++;
+            if(delete is not null)delete(path);
+            else File.Delete(path);
+        }
+    }
