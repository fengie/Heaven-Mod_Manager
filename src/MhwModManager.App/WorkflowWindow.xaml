<Window x:Class="MhwModManager.App.WorkflowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Loadouts, rules and diagnostics" Width="1180" Height="800" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="Your setup, explained" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Preview staged files, teach compatibility rules, and reconstruct portable loadouts." Style="{StaticResource PageSubtitle}"/>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" Text="Loading…"/>
  <TabControl x:Name="Tabs">
   <TabItem Header="Effective files">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="Refresh preview" Click="RefreshClick"/><TextBox x:Name="PathFilter" ToolTip="Filter by path or provider" TextChanged="FilterChanged"/></DockPanel>
     <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TreeView Background="{StaticResource Panel}" Foreground="{StaticResource Text}" x:Name="Folders" SelectedItemChanged="FolderSelected" Margin="0,0,10,0"/><DataGrid x:Name="Files" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="FileSelected" EnableRowVirtualization="True">
      <DataGrid.Columns><DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Effective provider" Binding="{Binding WinnerName, Mode=OneWay}" Width="240"/><DataGridCheckBoxColumn Header="Blocked" Binding="{Binding Blocking, Mode=OneWay}"/></DataGrid.Columns>
     </DataGrid></Grid>
     <TextBox x:Name="Explanation" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </TabItem>
   <TabItem Header="Loadout import">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel><Button Content="Open recipe…" Click="OpenRecipe"/><Button Content="Export applied setup…" Click="ExportRecipe"/><TextBox x:Name="RecipeName" Width="210" Text="Imported loadout" ToolTip="New profile name"/><Button Content="Save matched entries as profile" Click="ImportRecipe"/><Button Content="Restore matched family groups" Click="RestoreRecipeFamilies"/></WrapPanel>
     <DataGrid x:Name="RecipeRows" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,12"><DataGrid.Columns><DataGridTextColumn Header="Mod" Binding="{Binding Entry.DisplayName, Mode=OneWay}" Width="220"/><DataGridTextColumn Header="Status" Binding="{Binding Kind, Mode=OneWay}" Width="170"/><DataGridTextColumn Header="Evidence / next step" Binding="{Binding Detail, Mode=OneWay}" Width="*"/></DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="Recipes contain references and hashes, never mod files. Download missing archives from their authors and preview again. Import saves a profile; stage it in Profiles before Apply. Family restoration is a separate reviewed action and refuses to overwrite existing local groups. Existing compatibility rules remain authoritative."/>
    </Grid>
   </TabItem>
   <TabItem Header="Profiles &amp; diff">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><TextBox x:Name="ProfileName" Width="200" Text="New loadout"/><ComboBox x:Name="ParentProfile" Width="220" DisplayMemberPath="Name" ToolTip="Optional parent"/><Button Content="No parent" Click="ClearParent"/><Button Content="Save staged setup" Click="SaveProfile"/></WrapPanel>
     <WrapPanel Grid.Row="1" Margin="0,12"><ComboBox x:Name="ProfileA" Width="220" DisplayMemberPath="Name"/><TextBlock Text=" → " VerticalAlignment="Center"/><ComboBox x:Name="ProfileB" Width="220" DisplayMemberPath="Name"/><Button Content="Compare" Click="CompareProfiles"/><Button Content="Stage right profile" Click="StageProfile"/></WrapPanel>
     <TextBox x:Name="ProfileDiff" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </TabItem>
   <TabItem Header="Rules">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><ComboBox x:Name="RuleKindBox" Width="190" SelectedIndex="0"><ComboBoxItem Content="Overlay"/><ComboBoxItem Content="Incompatible"/><ComboBoxItem Content="Exact file winner"/><ComboBoxItem Content="Shared provider"/><ComboBoxItem Content="Family / optional"/><ComboBoxItem Content="Priority relationship"/></ComboBox><ComboBox x:Name="LeftMod" Width="260" DisplayMemberPath="DisplayName" ToolTip="Base / first mod"/><ComboBox x:Name="RightMod" Width="260" DisplayMemberPath="DisplayName" ToolTip="Winner / optional / second mod"/></WrapPanel>
     <TextBox x:Name="RulePath" Grid.Row="1" Margin="0,8" ToolTip="Exact path, shared resource namespace, or family name"/>
     <WrapPanel Grid.Row="2"><TextBox x:Name="RuleReason" Width="370" Text="User compatibility decision"/><Button Content="New rule" Click="NewRule"/><Button Content="Save rule" Click="SaveRule"/><Button Content="Delete selected rule" Click="DeleteRule"/><Button Content="Clear provider pin" Click="ClearProvider"/></WrapPanel>
     <DataGrid x:Name="RuleRows" Grid.Row="3" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,12" SelectionChanged="RuleSelected"><DataGrid.Columns><DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope, Mode=OneWay}"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="Path" Binding="{Binding PathPattern, Mode=OneWay}" Width="240"/></DataGrid.Columns></DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Relationships">
    <DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="GraphMod" Width="300" DisplayMemberPath="DisplayName"/><Button Content="Show neighborhood" Click="GraphClick"/><TextBlock Text="Gold: overlay → winner · Red: incompatible · Blue: same family" VerticalAlignment="Center" Margin="12"/></WrapPanel><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="GraphCanvas" Width="1000" Height="800"/></ScrollViewer></DockPanel>
   </TabItem>
   <TabItem Header="Update migration">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel><ComboBox x:Name="OldMod" Width="260" DisplayMemberPath="DisplayName"/><TextBlock Text=" → " VerticalAlignment="Center"/><ComboBox x:Name="NewMod" Width="260" DisplayMemberPath="DisplayName"/><Button Content="Preview upgrade" Click="PreviewUpgrade"/><Button x:Name="UpgradeButton" Content="Upgrade safely" Click="Upgrade" IsEnabled="False"/></WrapPanel>
     <TextBox x:Name="UpdateDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12"/>
    </Grid>
   </TabItem>
   <TabItem Header="Stability history">
    <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap" Text="Observed launches are evidence, not a quality score. Startup failure associations do not prove that a mod caused the failure. No record means untested."/><DataGrid x:Name="TrustRows" IsReadOnly="True" AutoGenerateColumns="True"/></DockPanel>
   </TabItem>
   <TabItem Header="Game adapter">
    <TextBox x:Name="AdapterDetails" Margin="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
