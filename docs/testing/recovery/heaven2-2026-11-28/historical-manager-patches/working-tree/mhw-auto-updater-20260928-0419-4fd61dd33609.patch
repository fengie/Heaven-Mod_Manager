+        this.state = state ?? throw new ArgumentNullException(nameof(state));
+        this.packages = packages ?? throw new ArgumentNullException(nameof(packages));
+        this.source = source ?? throw new ArgumentNullException(nameof(source));
+        CredentialStore = credentialStore ?? throw new ArgumentNullException(nameof(credentialStore));
+        this.ownedHttp = ownedHttp;
+        Snapshot = new UpdateSnapshot(
+            UpdateStatusKind.Idle,
+            $"Current {current.Display}",
+            current);
+    }
+
+    public IUpdateCredentialStore CredentialStore { get; }
+    public UpdateSnapshot Snapshot { get; private set; }
+    public event Action<UpdateSnapshot>? Changed;
+
+    public static UpdateCoordinator CreateDefault(string installRoot, BuildIdentity identity)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var paths = UpdateStatePaths.ForInstallRoot(installRoot);
+        var state = new UpdateStateStore(paths);
+        var credentials = new WindowsCredentialStore();
+        var http = GitHubUpdateSource.CreateDefaultHttpClient();
+        var source = new GitHubUpdateSource(http, credentials);
+        var packages = new UpdatePackageService(state);
+        return new UpdateCoordinator(identity, state, packages, source, credentials, http);
+    }
+
+    public async Task<UpdateSnapshot> CheckAndStageAsync(
+        IReadOnlyList<string> restartArguments,
+        CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await gate.WaitAsync(ct).ConfigureAwait(false);
+        try
+        {
+            SetSnapshot(UpdateStatusKind.Checking, $"Checking for updates… Current {current.Display}");
+            MasterDebugLog.Write("UPDATER",
+                $"Check started: product={current.ProductVersion}; build={current.BuildNumber}; source={current.SourceSha}");
+
+            var candidate = await source.GetLatestAsync(ct).ConfigureAwait(false);
+            if (candidate is null)
+            {
+                SetSnapshot(UpdateStatusKind.Current, $"No published update is available. Current {current.Display}");
+                return Snapshot;
+            }
+
+            UpdateOrdering.ValidateNoAmbiguousSameBuild(current, candidate.Manifest);
+            if (!UpdateOrdering.IsNewer(current, candidate.Manifest))
+            {
+                SetSnapshot(UpdateStatusKind.Current,
+                    $"Up to date. Current {current.Display}; latest build {candidate.Manifest.BuildNumber}.",
+                    candidate.Manifest.Identity);
+                MasterDebugLog.Write("UPDATER",
+                    $"No update: current={current.BuildNumber}; remote={candidate.Manifest.BuildNumber}");
+                return Snapshot;
+            }
+
+            SetSnapshot(UpdateStatusKind.UpdateAvailable,
+                $"Update available: {candidate.Manifest.Identity.Display}", candidate.Manifest.Identity);
+            var installed = await ManagedInstall.TryLoadAsync(
+                state.Paths.InstallRoot, ct).ConfigureAwait(false);
+            if (!current.IsPublishedBuild || installed is null)
+            {
+                SetSnapshot(UpdateStatusKind.Disabled,
+                    $"Build {candidate.Manifest.BuildNumber} is available, but automatic apply is disabled for this development/unmanaged installation.",
+                    candidate.Manifest.Identity);
+                return Snapshot;
+            }
+
+            if (installed.Value.Payload.BuildNumber != current.BuildNumber ||
+                !installed.Value.Payload.SourceSha.Equals(current.SourceSha, StringComparison.OrdinalIgnoreCase))
+            {
+                SetSnapshot(UpdateStatusKind.Disabled,
+                    "Automatic apply is disabled because the installed payload identity does not match the running build.",
+                    candidate.Manifest.Identity);
+                return Snapshot;
+            }
+
+            var archive = Path.Combine(state.Paths.DownloadsRoot, candidate.Manifest.Artifact);
+            SetSnapshot(UpdateStatusKind.Downloading,
+                $"Downloading verified build {candidate.Manifest.BuildNumber}…", candidate.Manifest.Identity);
+            var reuse = false;
+            if (File.Exists(archive))
+            {
+                try
+                {
+                    await UpdatePackageService.VerifyArchiveAsync(
+                        candidate.Manifest, archive, ct).ConfigureAwait(false);
+                    reuse = true;
+                }
+                catch (Exception ex) when (ex is IOException or InvalidDataException)
+                {
+                    MasterDebugLog.Write("UPDATER", "Cached update archive failed verification and will be replaced.", ex);
+                    File.Delete(archive);
+                }
+            }
+            if (!reuse)
+                await source.DownloadArtifactAsync(candidate, archive, ct).ConfigureAwait(false);
+
+            var existingStage = state.Paths.StageDirectory(candidate.Manifest.ReleaseTag);
+            if (Directory.Exists(existingStage))
+            {
+                var pending = await state.LoadPendingAsync(ct).ConfigureAwait(false);
+                if (pending is not null && pending.UpdateId.Equals(candidate.Manifest.ReleaseTag, StringComparison.Ordinal))
+                {
+                    await packages.VerifyStagedAsync(pending, ct).ConfigureAwait(false);
+                    SetSnapshot(UpdateStatusKind.Staged,
+                        $"Verified build {candidate.Manifest.BuildNumber} is staged and ready to install.",
+                        candidate.Manifest.Identity, pending.UpdateId);
+                    return Snapshot;
+                }
+                UpdatePathSafety.DeleteOwnedTreeSafe(existingStage);
+            }
+
+            SetSnapshot(UpdateStatusKind.Staging,
+                $"Verifying and staging build {candidate.Manifest.BuildNumber}…", candidate.Manifest.Identity);
+            var staged = await packages.StageAsync(
+                candidate.Manifest,
+                archive,
+                UpdateCommandLine.FilterUserArguments(restartArguments),
+                ct).ConfigureAwait(false);
+            SetSnapshot(UpdateStatusKind.Staged,
+                $"Verified build {candidate.Manifest.BuildNumber} is staged and ready to install.",
+                candidate.Manifest.Identity,
+                staged.UpdateId);
+            return Snapshot;
+        }
+        catch (UpdateAuthenticationException ex)
+        {
+            MasterDebugLog.Write("UPDATER", "Update authentication failed without affecting application startup.", ex);
+            SetSnapshot(UpdateStatusKind.AuthenticationRequired, ex.Message);
+            return Snapshot;
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            SetSnapshot(UpdateStatusKind.Idle, $"Update check cancelled. Current {current.Display}");
+            throw;
+        }
+        catch (Exception ex) when (ex is UpdateTransportException
+                                   or HttpRequestException
+                                   or IOException
+                                   or InvalidDataException
+                                   or UnauthorizedAccessException)
+        {
+            MasterDebugLog.Write("UPDATER", "Update check/download/staging failed safely.", ex);
+            SetSnapshot(UpdateStatusKind.Error,
+                $"Update check failed safely: {ex.Message} Current application remains unchanged.");
+            return Snapshot;
+        }
+        finally
+        {
+            gate.Release();
+        }
+    }
+
+    public async Task<bool> LaunchStagedHelperAsync(int currentPid, CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await gate.WaitAsync(ct).ConfigureAwait(false);
+        try
+        {
+            var pending = await state.LoadPendingAsync(ct).ConfigureAwait(false);
+            if (pending is null) return false;
+            await packages.VerifyStagedAsync(pending, ct).ConfigureAwait(false);
+            var start = UpdateCommandLine.BuildHelperStartInfo(pending, currentPid);
+            ProcessDebug.Start(start, "verified updater helper");
+            SetSnapshot(UpdateStatusKind.Applying,
+                $"Installing verified build {pending.Manifest.BuildNumber}; application will restart.",
+                pending.Manifest.Identity,
+                pending.UpdateId);
+            MasterDebugLog.Write("UPDATER",
+                $"Updater helper launched: pid={currentPid}; targetBuild={pending.Manifest.BuildNumber}; source={pending.Manifest.SourceSha}");
+            return true;
+        }
+        finally
+        {
+            gate.Release();
+        }
+    }
+
+    public async Task ConfirmHealthyStartupIfPendingAsync(CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await gate.WaitAsync(ct).ConfigureAwait(false);
+        try
+        {
+            var pending = await state.LoadPendingAsync(ct).ConfigureAwait(false);
+            if (pending is null) return;
+            var journal = await state.LoadJournalAsync(ct).ConfigureAwait(false);
+            if (journal?.Phase != UpdateApplyPhase.AppliedAwaitingHealth ||
+                !journal.UpdateId.Equals(pending.UpdateId, StringComparison.Ordinal))
+                return;
+            if (current.BuildNumber != pending.Manifest.BuildNumber ||
+                !current.SourceSha.Equals(pending.Manifest.SourceSha, StringComparison.OrdinalIgnoreCase))
+                return;
+
+            await state.WriteConfirmationAsync(pending.UpdateId, current, ct).ConfigureAwait(false);
+            MasterDebugLog.Write("UPDATER",
+                $"Healthy startup checkpoint recorded: build={current.BuildNumber}; source={current.SourceSha}");
+            SetSnapshot(UpdateStatusKind.Current,
+                $"Updated successfully. Current {current.Display}", current);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException)
+        {
+            MasterDebugLog.Write("UPDATER",
+                "Could not record updater startup confirmation; rollback material is retained.", ex);
+        }
+        finally
+        {
+            gate.Release();
+        }
+    }
+
+    public async Task TryCleanupCommittedResidueAsync(CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await gate.WaitAsync(ct).ConfigureAwait(false);
+        try
+        {
+            var journal = await state.LoadJournalAsync(ct).ConfigureAwait(false);
+            if (journal?.Phase != UpdateApplyPhase.Committed) return;
+            if (Directory.Exists(journal.StagingRoot))
+            {
+                try
+                {
+                    UpdatePathSafety.DeleteOwnedTreeSafe(journal.StagingRoot);
+                }
+                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException)
+                {
+                    MasterDebugLog.Write("UPDATER", "Committed staging cleanup remains deferred.", ex);
+                }
+            }
+        }
+        finally
+        {
+            gate.Release();
+        }
+    }
+
+    private void SetSnapshot(
+        UpdateStatusKind status,
+        string message,
+        BuildIdentity? latest = null,
+        string? pendingId = null)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        Snapshot = new UpdateSnapshot(status, message, current, latest, pendingId);
+        Changed?.Invoke(Snapshot);
+    }
+
+    public void Dispose()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        if (disposed) return;
+        disposed = true;
+        gate.Dispose();
+        ownedHttp?.Dispose();
+        GC.SuppressFinalize(this);
+    }
+}
