+using System.Net;
+using System.Net.Http.Headers;
+using System.Security.Cryptography;
+using System.Text.Json;
+using MhwModManager.Core;
+
+namespace MhwModManager.Updater;
+
+public interface IUpdateSource
+{
+    Task<UpdateCandidate?> GetLatestAsync(CancellationToken ct);
+    Task DownloadArtifactAsync(UpdateCandidate candidate, string destination, CancellationToken ct);
+}
+
+public sealed class UpdateAuthenticationException(string message) : Exception(message);
+public sealed class UpdateTransportException(string message, Exception? inner = null) : Exception(message, inner);
+
+public sealed class GitHubUpdateSource : IUpdateSource
+{
+    private static readonly HashSet<string> AllowedHosts = new(StringComparer.OrdinalIgnoreCase)
+    {
+        "api.github.com",
+        "github.com",
+        "release-assets.githubusercontent.com",
+        "objects.githubusercontent.com",
+        "github-releases.githubusercontent.com"
+    };
+
+    private readonly HttpClient http;
+    private readonly IUpdateCredentialSource credentials;
+
+    public GitHubUpdateSource(HttpClient http, IUpdateCredentialSource credentials)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        this.http = http ?? throw new ArgumentNullException(nameof(http));
+        this.credentials = credentials ?? throw new ArgumentNullException(nameof(credentials));
+    }
+
+    public static HttpClient CreateDefaultHttpClient()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var handler = new SocketsHttpHandler
+        {
+            AllowAutoRedirect = false,
+            AutomaticDecompression = DecompressionMethods.GZip | DecompressionMethods.Deflate,
+            ConnectTimeout = TimeSpan.FromSeconds(15)
+        };
+        return new HttpClient(handler, disposeHandler: true)
+        {
+            Timeout = Timeout.InfiniteTimeSpan
+        };
+    }
+
+    public async Task<UpdateCandidate?> GetLatestAsync(CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var token = RequireToken();
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(60));
+
+        try
+        {
+            var releasesUri = new Uri("https://api.github.com/repos/fengie/mhw-mods/releases?per_page=100");
+            using var response = await SendFollowingAllowedRedirectsAsync(
+                releasesUri, token, "application/vnd.github+json", timeout.Token).ConfigureAwait(false);
+            await EnsureSuccessAsync(response).ConfigureAwait(false);
+            var bytes = await ReadBoundedAsync(
+                await response.Content.ReadAsStreamAsync(timeout.Token).ConfigureAwait(false),
+                8L * 1024 * 1024,
+                timeout.Token).ConfigureAwait(false);
+
+            var release = FindNewestRelease(bytes);
+            if (release is null) return null;
+
+            using var manifestResponse = await SendFollowingAllowedRedirectsAsync(
+                release.ManifestAssetUri, token, "application/octet-stream", timeout.Token).ConfigureAwait(false);
+            await EnsureSuccessAsync(manifestResponse).ConfigureAwait(false);
+            var manifestBytes = await ReadBoundedAsync(
+                await manifestResponse.Content.ReadAsStreamAsync(timeout.Token).ConfigureAwait(false),
+                UpdateConstants.MaxManifestBytes,
+                timeout.Token).ConfigureAwait(false);
+            var manifest = UpdateValidation.ParseManifest(manifestBytes);
+
+            if (!manifest.ReleaseTag.Equals(release.Tag, StringComparison.Ordinal) ||
+                manifest.BuildNumber != release.BuildNumber ||
+                !manifest.SourceSha.StartsWith(release.ShortSha, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("GitHub release identity does not match the update manifest.");
+
+            var artifact = release.Assets.FirstOrDefault(x =>
+                x.Name.Equals(manifest.Artifact, StringComparison.Ordinal));
+            if (artifact is null)
+                throw new InvalidDataException("Update release does not contain the manifest artifact.");
+            if (artifact.Size != manifest.Size)
+                throw new InvalidDataException("GitHub asset size does not match the update manifest.");
+
+            MasterDebugLog.Write("UPDATER",
+                $"Latest release resolved: build={manifest.BuildNumber}; source={manifest.SourceSha}; artifact={manifest.Artifact}; bytes={manifest.Size}");
+            return new UpdateCandidate { Manifest = manifest, ArtifactApiUri = artifact.ApiUri };
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            throw new UpdateTransportException("The update service timed out.");
+        }
+        catch (HttpRequestException ex)
+        {
+            throw new UpdateTransportException("The update service could not be reached.", ex);
+        }
+    }
+
+    public async Task DownloadArtifactAsync(
+        UpdateCandidate candidate,
+        string destination,
+        CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        ArgumentNullException.ThrowIfNull(candidate);
+        var manifest = candidate.Manifest;
+        UpdateValidation.ValidateManifest(manifest);
+        var token = RequireToken();
+        EnsureFreeSpace(destination, manifest.Size);
+
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromMinutes(15));
+        Directory.CreateDirectory(Path.GetDirectoryName(destination) ??
+                                  throw new InvalidDataException("Download destination has no parent."));
+        if (File.Exists(destination)) File.Delete(destination);
+
+        try
+        {
+            using var response = await SendFollowingAllowedRedirectsAsync(
+                candidate.ArtifactApiUri, token, "application/octet-stream", timeout.Token).ConfigureAwait(false);
+            await EnsureSuccessAsync(response).ConfigureAwait(false);
+            if (response.Content.Headers.ContentLength is long contentLength &&
+                contentLength != manifest.Size)
+                throw new InvalidDataException(
+                    $"Update download length mismatch before transfer. Expected {manifest.Size}, got {contentLength}.");
+
+            await using var input = await response.Content.ReadAsStreamAsync(timeout.Token).ConfigureAwait(false);
+            await using var output = new FileStream(
+                destination, FileMode.CreateNew, FileAccess.Write, FileShare.None, 256 * 1024,
+                FileOptions.Asynchronous | FileOptions.SequentialScan);
+            using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+            var buffer = new byte[256 * 1024];
+            long total = 0;
+            while (true)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                var read = await input.ReadAsync(buffer.AsMemory(), timeout.Token).ConfigureAwait(false);
+                if (read == 0) break;
+                total = checked(total + read);
+                if (total > manifest.Size || total > UpdateConstants.MaxArtifactBytes)
+                    throw new InvalidDataException("Update download exceeded its declared size.");
+                await output.WriteAsync(buffer.AsMemory(0, read), timeout.Token).ConfigureAwait(false);
+                hash.AppendData(buffer, 0, read);
+            }
+            await output.FlushAsync(timeout.Token).ConfigureAwait(false);
+            output.Flush(flushToDisk: true);
+
+            if (total != manifest.Size)
+                throw new InvalidDataException(
+                    $"Update download was truncated. Expected {manifest.Size} bytes, got {total}.");
+            var actual = Convert.ToHexString(hash.GetHashAndReset());
+            if (!actual.Equals(manifest.Sha256, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException(
