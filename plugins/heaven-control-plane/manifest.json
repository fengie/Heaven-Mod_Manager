{
  "schema": "heaven-control-plane/manifest/v1",
  "name": "heaven-control-plane",
  "version": "0.5.0",
  "bridge_protocol": "chatgpt-heaven-bridge-v2",
  "entrypoint": "heaven_control_plane.service:HeavenControlPlane",
  "capability_schema": "heaven-control-plane/v1",
  "security": {
    "plaintext_secrets_in_relay": false,
    "inline_secret_environment_values": false,
    "host_secret_handles": true,
    "filesystem_path_traversal_segments": false,
    "capability_permissions_enforced": true,
    "artifact_secret_canary_scan": true,
    "opaque_secret_handles": true,
    "permission_broker": true
  },
  "capabilities": [
    "control.discovery",
    "control.health",
    "control.cancel",
    "execution.run",
    "execution.session.start",
    "execution.session.read",
    "execution.session.input",
    "execution.session.stop",
    "execution.session.list",
    "filesystem.read",
    "filesystem.write",
    "filesystem.patch",
    "filesystem.search",
    "git.status",
    "git.diff",
    "git.verify_remote_main",
    "verification.detect",
    "verification.run",
    "observability.logs.page",
    "observability.artifacts.page",
    "index.refresh",
    "index.stats",
    "index.search.text",
    "index.search.symbols"
  ],
  "optional_providers": {
    "indexing": "IndexCapabilityProvider"
  },
  "capability_permissions": {
    "control.discovery": "control.read",
    "control.health": "control.read",
    "control.cancel": "execution.cancel",
    "execution.run": "execution.run",
    "execution.session.start": "execution.session",
    "execution.session.read": "execution.session.read",
    "execution.session.input": "execution.session",
    "execution.session.stop": "execution.session",
    "execution.session.list": "execution.session.read",
    "filesystem.read": "filesystem.read",
    "filesystem.write": "filesystem.write",
    "filesystem.patch": "filesystem.write",
    "filesystem.search": "filesystem.read",
    "git.status": "repository.read",
    "git.diff": "repository.read",
    "git.verify_remote_main": "repository.verify",
    "verification.detect": "verification.read",
    "verification.run": "verification.run",
    "observability.logs.page": "observability.read",
    "observability.artifacts.page": "observability.read",
    "index.refresh": "repository.read",
    "index.stats": "repository.read",
    "index.search.text": "repository.read",
    "index.search.symbols": "repository.read"
  }
}
