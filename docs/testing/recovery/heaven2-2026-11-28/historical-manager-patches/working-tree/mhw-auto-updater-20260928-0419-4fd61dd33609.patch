+using System.Windows;
+using CommunityToolkit.Mvvm.ComponentModel;
+using CommunityToolkit.Mvvm.Input;
+using MhwModManager.Core;
+using MhwModManager.Updater;
+
+namespace MhwModManager.App.ViewModels;
+
+public sealed partial class MainWindowViewModel
+{
+    private Task? updateTask;
+    private IReadOnlyList<string> updateRestartArguments = Array.Empty<string>();
+
+    [ObservableProperty]
+    private string updateStatusText = "Update service idle.";
+
+    public string BuildLabel
+    {
+        get
+        {
+            using var __mhwTrace = MasterDebugLog.BeginMethod();
+            var build = s.Updates.Snapshot.Current;
+            return build.BuildNumber > 0
+                ? $"v{build.ProductVersion} · b{build.BuildNumber}"
+                : $"v{build.ProductVersion} · local";
+        }
+    }
+
+    public string BuildDetail
+    {
+        get
+        {
+            using var __mhwTrace = MasterDebugLog.BeginMethod();
+            return $"Manager build: {s.Updates.Snapshot.Current.Display}";
+        }
+    }
+
+    private void InitializeUpdateIntegration()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        s.Updates.Changed += OnUpdateSnapshotChanged;
+        ApplyUpdateSnapshot(s.Updates.Snapshot);
+    }
+
+    public void StartAutomaticUpdateCheck(IReadOnlyList<string> arguments)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        updateRestartArguments = arguments.ToArray();
+        if (updateTask is { IsCompleted: false }) return;
+        updateTask = RunAutomaticUpdateCheckAsync(backgroundCts.Token);
+    }
+
+    private async Task RunAutomaticUpdateCheckAsync(CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        try
+        {
+            await s.Updates.CheckAndStageAsync(updateRestartArguments, ct);
+            await TryAutoApplyIfSafeAsync(ct);
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested)
+        {
+            MasterDebugLog.Write("UPDATER", "Automatic update check cancelled by application lifetime.");
+        }
+        catch (Exception ex)
+        {
+            MasterDebugLog.Write("UPDATER",
+                "Unexpected automatic update integration failure; current application remains available.", ex);
+            await Application.Current.Dispatcher.InvokeAsync(() =>
+                UpdateStatusText = $"Update integration failed safely: {ex.Message}");
+        }
+    }
+
+    [RelayCommand]
+    private async Task CheckForManagerUpdates()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        await RunBusy(
+            "manager.update.check",
+            "Checking manager updates",
+            "Checking the verified private release feed…",
+            true,
+            async ct =>
+            {
+                await s.Updates.CheckAndStageAsync(updateRestartArguments, ct);
+                await TryAutoApplyIfSafeAsync(ct);
+            });
+    }
+
+    [RelayCommand]
+    private async Task ConfigureUpdateAccess()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var dialog = new UpdateCredentialWindow
+        {
+            Owner = Application.Current.MainWindow
+        };
+        if (dialog.ShowDialog() != true) return;
+        try
+        {
+            s.Updates.CredentialStore.SaveToken(dialog.Token);
+            UpdateStatusText =
+                "Private update access saved securely in Windows Credential Manager. Checking now…";
+            await CheckForManagerUpdates();
+        }
+        catch (Exception ex) when (ex is UnauthorizedAccessException
+                                   or System.ComponentModel.Win32Exception
+                                   or PlatformNotSupportedException)
+        {
+            MasterDebugLog.Write("UPDATER", "Could not save private update access.", ex);
+            UpdateStatusText = $"Could not save private update access: {ex.Message}";
+        }
+    }
+
+    private async Task TryAutoApplyIfSafeAsync(CancellationToken ct)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        if (s.Updates.Snapshot.Status != UpdateStatusKind.Staged) return;
+
+        var blockers = await Task.Run(
+            () => s.ProcessGuard.GetKnownBlockers(),
+            ct);
+        if (CriticalOperation || BusyVisibility == Visibility.Visible || StagedCount > 0 || blockers.Count > 0)
+        {
+            var reason = CriticalOperation
+                ? "a critical manager operation is active"
+                : BusyVisibility == Visibility.Visible
+                    ? "another manager operation is active"
+                    : StagedCount > 0
+                        ? "you have unapplied mod changes"
+                        : "the game is running";
+            UpdateStatusText =
+                $"{s.Updates.Snapshot.Message} Installation is deferred because {reason}; it will retry on the next safe launch.";
+            return;
+        }
+
+        if (!await s.Updates.LaunchStagedHelperAsync(Environment.ProcessId, ct)) return;
+        await Application.Current.Dispatcher.InvokeAsync(() =>
+        {
+            MasterDebugLog.Write("UPDATER", "Normal application shutdown requested for verified update apply.");
+            Application.Current.Shutdown(0);
+        });
+    }
+
+    private void OnUpdateSnapshotChanged(UpdateSnapshot snapshot)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        var dispatcher = Application.Current?.Dispatcher;
+        if (dispatcher is not null && !dispatcher.CheckAccess())
+        {
+            _ = dispatcher.BeginInvoke(() => ApplyUpdateSnapshot(snapshot));
+            return;
+        }
+        ApplyUpdateSnapshot(snapshot);
+    }
+
+    private void ApplyUpdateSnapshot(UpdateSnapshot snapshot)
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        UpdateStatusText = snapshot.Message;
+        OnPropertyChanged(nameof(BuildLabel));
+        OnPropertyChanged(nameof(BuildDetail));
+    }
+
+    private void DisposeUpdateIntegration()
+    {
+        using var __mhwTrace = MasterDebugLog.BeginMethod();
+        s.Updates.Changed -= OnUpdateSnapshotChanged;
+    }
+}
